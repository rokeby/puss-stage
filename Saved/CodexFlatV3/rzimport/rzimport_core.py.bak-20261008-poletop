def ledger_name(plan):
    return "rzimport_ledger_%s.json" % plan["hash8"]


def dry_latest_name(plan):
    return "rzimport_dry_%s_LATEST.json" % plan["hash8"]


def confirm_for(mode, plan=None, batch=None):
    if mode == "DRY":
        return "DRY RZIMPORT"
    if mode == "VERIFY":
        return "VERIFY RZIMPORT"
    if mode == "UNDO_LIST":
        return "UNDO_LIST RZIMPORT"
    if mode == "APPLY":
        require(plan is not None and batch is not None, "APPLY_NEEDS_PLAN_AND_BATCH")
        return "APPLY RZIMPORT BATCH %d #%s" % (int(batch), plan["hash8"])
    raise PlanError("MODE_INVALID %r" % (mode,))


def validate_args(args, plan=None):
    mode = str(args.get("mode") or "").upper()
    require(mode in ("DRY", "APPLY", "VERIFY", "UNDO_LIST"), "MODE_INVALID %r" % (mode,))
    require(isinstance(args.get("manifests"), list) and args["manifests"], "MANIFESTS_MISSING (args 'manifests')")
    batch = None
    if mode == "APPLY":
        try:
            batch = int(args.get("batch"))
        except (TypeError, ValueError):
            raise PlanError("BATCH_INVALID %r" % (args.get("batch"),))
        require(plan is not None and 1 <= batch <= len(plan["batches"]), "BATCH_INVALID %r" % (batch,))
    want = confirm_for(mode, plan, batch)
    require(args.get("confirm") == want, "CONFIRM_MISMATCH %r want %r" % (args.get("confirm"), want))
    return mode, batch


def undo_list(plan, ledger=None):
    """Manual undo for a create-only import: package list in a reference-safe delete order. NOTHING here deletes."""
    done = set()
    if ledger:
        done = {int(k) for k, v in ledger.get("batches", {}).items() if v.get("status") == "SAVED"}
    rows = []
    for b in plan["batches"]:
        if ledger is not None and b["batch"] not in done:
            continue
        pk = b["packages"]
        order = [p for p in pk if "/Materials/Instances/" in p] + [p for p in pk if "/T5P/" in p or "/T5J/" in p]
        order += [p for p in pk if p not in order]
        rows.append({"batch": b["batch"], "owners": b["owners"], "delete_in_order": order,
                     "files": ["Content/%s.uasset" % p[len("/Game/"):] for p in order]})
    return {"mode": "UNDO_LIST", "auto_delete": False, "plan": plan["hash8"],
            "how": ["1 Nothing may reference these meshes: REVERT every rzswap APPLY that placed them first.",
                    "2 In the Content Browser select a batch's assets (MIs, then the mesh, then textures) and Delete; "
                    "the reference check must report NO referencers.  Never Force Delete.",
                    "3 Save nothing else; VERIFY then reports the batch as missing.",
                    "Never Save All; never delete Passage06 assets (the reused aged Common set belongs to P06)."],
            "batches": rows}


def slim(plan):
    s = json.loads(json.dumps(plan))
    for w in s["wings"].values():
        w.pop("validation", None)
    return s


