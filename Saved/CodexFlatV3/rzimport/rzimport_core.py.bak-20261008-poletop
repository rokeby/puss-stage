def _report_for(project, entry, variant):
    """Per-item build report: t5p = RZ_HF_REPORT.json, t5j = RZ_BUILD_REPORT.json, both in the item dir (the
    manifest's build_report sits there) [meas P06 v2 + P02 v1 item dirs]."""
    item_dir = os.path.dirname(str(entry.get("build_report") or "").replace("\\", "/"))
    if not item_dir:
        item_dir = "/".join(str(entry["fbx"]).replace("\\", "/").split("/")[:5])
    name = "RZ_HF_REPORT.json" if variant == "t5p" else "RZ_BUILD_REPORT.json"
    return item_dir, item_dir + "/" + name


def _wing(project, mi, entry, record_hashes, refusals):
    asset = str(entry.get("asset", ""))
    tag = "%s" % asset
    variant = asset.rsplit("_", 1)[-1]
    side = str(entry.get("side"))
    mount = str(entry.get("mount") or "wing")
    passage = str(entry.get("intended_passage") or "")
    # the v2 valance manifest writes "VAL (upper wing / valance; passage chosen at placement)": key on the token
    if passage.split(" ", 1)[0] == "VAL":
        passage = "VAL"
    if mount not in MOUNTS:
        refusals.append("MOUNT_UNKNOWN %s %s" % (tag, mount))
        return None
    if passage not in PASSAGES:
        refusals.append("PASSAGE_UNKNOWN %s %r" % (tag, passage))
        return None
    if variant not in MESH_FOLDERS or not str(entry.get("variant", "")).startswith(variant):
        refusals.append("VARIANT_UNKNOWN %s %s" % (tag, entry.get("variant")))
        return None
    if not asset.startswith("SM_FlatV3_"):
        refusals.append("ASSET_PREFIX %s" % asset)
        return None
    owner = asset[len("SM_FlatV3_"):-len("_" + variant)]
    if not owner.startswith(passage + "_"):
        refusals.append("OWNER_NOT_PASSAGE_PREFIXED %s (intended_passage %s)" % (owner, passage))
    want_suffix = "_C" if mount == "top-border" else "_" + side
    if not owner.endswith(want_suffix):
        refusals.append("OWNER_SIDE %s %s mount=%s side=%s" % (tag, owner, mount, side))
    if mount == "wing" and side not in ("L", "R"):
        refusals.append("WING_SIDE %s %r" % (tag, side))
    item_dir, report_rel = _report_for(project, entry, variant)
    rp_path = _abs(project, report_rel)
    rp = load_json(rp_path) if os.path.isfile(rp_path) else None
    if rp is None or rp.get("status") != "PASS" or rp.get("owner") != owner or rp.get("fbx") != entry.get("fbx") \
            or rp.get("fbx_sha256") != entry.get("fbx_sha256"):
        refusals.append("BUILD_REPORT_DISAGREES %s (%s)" % (tag, report_rel))
    if not entry.get("validation_pass"):
        refusals.append("VALIDATION_NOT_PASS %s" % tag)
    if list(entry.get("slots") or SLOTS) != list(SLOTS):
        refusals.append("MANIFEST_SLOTS %s %s" % (tag, entry.get("slots")))
    stencil = [a for a in entry.get("aged_textures", []) if a["path"].endswith(STENCIL_PNG)]
    if len(stencil) != 1:
        refusals.append("STENCIL_COUNT %s" % tag)
        return None
    for a in entry["aged_textures"]:
        n = stem(a["path"])
        if n in COMMON_AGED and record_hashes.get(n) != [a["sha256"]]:
            refusals.append("AGED_COMMON_HASH %s %s (not the set already in %s)" % (tag, n, AGED_COMMON_ROOT))
    if sorted(stem(a["path"]) for a in entry["aged_textures"]) != sorted(COMMON_AGED + (stem(STENCIL_PNG),)):
        refusals.append("AGED_SET %s" % tag)
    probe_rel = ((rp or {}).get("edge_gate") or {}).get("probe") or (item_dir + "/edge_gate/edge_probe.json")
    sources = {"fbx": (entry["fbx"], entry["fbx_sha256"]),
               "socket": (entry["socket_sidecar"], entry["socket_sidecar_sha256"]),
               "SkinColor": (entry["textures"]["SkinColor"]["path"], entry["textures"]["SkinColor"]["sha256"]),
               "SkinMask": (entry["textures"]["SkinMask"]["path"], entry["textures"]["SkinMask"]["sha256"]),
               "SkinNormal": (entry["textures"]["SkinNormal"]["path"], entry["textures"]["SkinNormal"]["sha256"]),
               "AgedStencil": (stencil[0]["path"], stencil[0]["sha256"]),
               "validation": (entry["validation"], None),
               "mi_params": ("%s/stage1/%s/skin_v3/%s_mi_params.json" % (item_dir, owner, owner), None),
               "edge_probe": (probe_rel, None),
               "build_report": (report_rel, None)}
    src = {}
    for key, (rel, want) in sources.items():
        p = _abs(project, rel)
        if not os.path.isfile(p):
            refusals.append("SOURCE_MISSING %s %s %s" % (tag, key, rel))
            continue
        got = sha_file(p)
        if want is not None and got != want:
            refusals.append("SOURCE_HASH_MISMATCH %s %s" % (tag, key))
        src[key] = {"rel": rel, "abs": p, "sha256": got}
    if len(src) != len(sources):
        return None
    validation = load_json(src["validation"]["abs"])
    sidecar = load_json(src["socket"]["abs"])
    mi_params = load_json(src["mi_params"]["abs"])
    probe = load_json(src["edge_probe"]["abs"])
    checks = validation.get("checks", {})
    if not validation.get("pass") or checks.get("fbx_lod_group", {}).get("mechanism") != "FBX LodGroup NodeAttribute":
        refusals.append("LODGROUP_GATE %s" % tag)
    if checks.get("material_slots_exact", {}).get("value") != list(SLOTS):
        refusals.append("SLOTS_IN_FBX %s" % tag)
    sock_names = sorted(r["name"] for r in sidecar.get("sockets", []))
    notes = []
    pole_geom = sidecar.get("baked_pole_geometry")
    if sidecar.get("asset") != asset:
        refusals.append("SIDECAR_ASSET %s %s" % (tag, sidecar.get("asset")))
    if mount == "wing":
        poles = sorted(checks.get("baked_poles_lod0", {}).get("details", {}))
        # Socket authority = the sidecar; it must agree with the BAKED POLE GEOMETRY the validator measured (the P06
        # kit's rule: validation.socket_contract.details under-lists Pole_2 on some builds [meas P06 picks 2, 3]).
        if sock_names != sorted(["SOCKET_Hinge", "SOCKET_Pivot"] + poles) or not poles or not pole_geom:
            refusals.append("SOCKET_SIDECAR_VS_BAKED_POLES %s %s vs poles %s" % (tag, sock_names, poles))
        contract_names = sorted(checks.get("socket_contract", {}).get("details", {}))
        if contract_names != sock_names:
            notes.append("validation.socket_contract lists %s; sidecar + baked poles carry %s (sidecar used)" % (
                contract_names, sock_names))
        by_sock = {r["name"]: r for r in sidecar.get("sockets", [])}
        if "SOCKET_Hinge" not in by_sock or max(abs(float(v)) for v in by_sock["SOCKET_Hinge"]["relative_location_cm"]) > 1.0:
            refusals.append("HINGE_NOT_AT_ORIGIN %s" % tag)
        if "SOCKET_Pivot" in by_sock:
            pz = float(by_sock["SOCKET_Pivot"]["relative_location_cm"][2])
            if abs(pz - float(entry["height_cm"]) * 0.5) > PIVOT_TOL_CM:
                refusals.append("PIVOT_Z_VS_MANIFEST_HEIGHT %s %.3f vs %.3f" % (tag, pz, float(entry["height_cm"]) * 0.5))
        else:
            refusals.append("NO_PIVOT_SOCKET %s" % tag)
    else:
        if sock_names:
            refusals.append("TOP_BORDER_HAS_SOCKETS %s %s" % (tag, sock_names))
        if pole_geom is not None:
            refusals.append("TOP_BORDER_HAS_BAKED_POLES %s" % tag)
        if str(validation.get("kind")) != "wave":
            refusals.append("TOP_BORDER_VALIDATION_KIND %s %r (rz_build_one validates top borders as 'wave')" % (
                tag, validation.get("kind")))
    mn, mx = expected_import_bounds(validation)
    if mount == "wing" and not side_extension_ok(side, mn, mx):
        refusals.append("SIDE_EXTENSION %s %s %s" % (tag, mn, mx))
    if mount == "top-border" and not top_centred_ok(mn, mx):
        refusals.append("TOP_NOT_CENTRED %s %s %s" % (tag, mn[1], mx[1]))
    hg = height_gate(mount, {"min": mn, "max": mx}, entry["height_cm"], pole_geom)
    if hg:
        refusals.append("%s %s" % (hg, tag))
    if mi_params.get("parents") != {"Front": PARENTS["Front"], "Flap": PARENTS["Flap"]}:
        refusals.append("MI_PARENT_MISMATCH %s %s" % (tag, mi_params.get("parents")))
    tp = mi_params.get("texture_parameters", {})
    col = stem(src["SkinColor"]["rel"])
    if stem(tp.get("SkinMask", "")) != stem(src["SkinMask"]["rel"]) or \
            stem(tp.get("SkinNormal", "")) != stem(src["SkinNormal"]["rel"]) or \
            stem(tp.get("SkinColor", "")) not in (col, col[:-1] if col.endswith("_o2p") else col):
        refusals.append("MI_PARAMS_TEXTURES_DISAGREE %s" % tag)
    hit = [x for x in probe if str(x.get("fbx", "")).replace("\\", "/").endswith(str(src["fbx"]["rel"]).replace("\\", "/"))]
    if len(hit) != 1:
        refusals.append("EDGE_PROBE_MISSING %s" % tag)
    else:
        geom = [{"lod": i, "edge_x": [o["slots"]["Edge"]["x_min"], o["slots"]["Edge"]["x_max"]],
                 "front_x": [o["slots"]["Front"]["x_min"], o["slots"]["Front"]["x_max"]]}
                for i, (_, o) in enumerate(sorted(hit[0]["objects"].items()))]
        ok, why = edge_geometry_ok(geom)
        if not ok:
            refusals.append("EDGE_PROBE %s %s" % (tag, why))
    flap_tris = (validation.get("triangle_counts_by_material") or {}).get("Flap")
    dest = {"mesh": "%s/%s" % (MESH_FOLDERS[variant], asset),
            "SkinColor": "%s/%s/%s" % (TEX_ROOT, owner, col),
            "SkinMask": "%s/%s/%s" % (TEX_ROOT, owner, stem(src["SkinMask"]["rel"])),
            "SkinNormal": "%s/%s/%s" % (TEX_ROOT, owner, stem(src["SkinNormal"]["rel"])),
            "AgedStencil": "%s/Aged/%s/T_%s_AgedPlywood_Stencil_Color" % (TEX_ROOT, owner, owner),
            "Front": "%s/MI_FlatV3_%s_Front" % (MI_ROOT, owner),
            "Flap": "%s/MI_FlatV3_%s_Flap" % (MI_ROOT, owner)}
    return {"key": owner, "owner": owner, "asset": asset, "variant": variant, "side": side, "mount": mount,
            "passage": passage, "manifest_index": mi, "pick": entry.get("pick_n"),
            "height_cm": float(entry["height_cm"]), "width_cm": round(float(validation["dimensions_m"][1]) * 100.0, 1),
            "thickness_cm": round(float(validation["dimensions_m"][0]) * 100.0, 2),
            "sources": src, "destinations": dest, "packages": sorted(dest.values()), "notes": notes,
            "expected": {"bounds_cm": {"min": mn, "max": mx},
                         "triangles": {"lod0": int(validation["triangle_counts"]["lod0"]),
                                       "lod1": int(validation["triangle_counts"]["lod1"])},
                         "sockets": sock_names, "pole": pole_geom,
                         "expect_flap": (flap_tris is None) or int(flap_tris) > 0,
                         "scalars": mi_params["scalar_parameters"],
                         "slot_materials": [dest["Front"], dest["Flap"], PARENTS["Timber"], PARENTS["Edge"]]},
            "validation": validation}


def auto_batches(wings):
    """<= 3 per batch, grouped by manifest then passage, ordered by pick (else owner): deterministic."""
    order = sorted(wings.values(), key=lambda w: (w["manifest_index"], w["passage"],
                                                  int(w["pick"]) if w.get("pick") is not None else 10 ** 6, w["owner"]))
    out, cur, key = [], [], None
    for w in order:
        k = (w["manifest_index"], w["passage"])
        if cur and (len(cur) == MAX_PER_BATCH or k != key):
            out.append(tuple(cur))
            cur = []
        cur.append(w["owner"])
        key = k
    if cur:
        out.append(tuple(cur))
    return tuple(out)


def build_plan(project, manifest_rels, batches=None):
    """Files-only plan.  Returns {wings, batches, refusals, inputs_hash, ...}; refusals empty = file gates pass."""
    refusals = []
    require(manifest_rels, "NO_MANIFESTS (args 'manifests': [<project-relative IMPORT_MANIFEST_v2_*.json>, ..])")
    record = load_json(_abs(project, COMMON_AGED_RECORD_REL))
    record_hashes = record.get("common_hashes", {}).get("P06", {})
    if record.get("status") != "PASS" or sorted(record_hashes) != sorted(COMMON_AGED):
        refusals.append("AGED_COMMON_RECORD %s" % COMMON_AGED_RECORD_REL)
    manifests, wings, owners_seen = [], {}, {}
    for mi, rel in enumerate(manifest_rels):
        mpath = _abs(project, rel)
        if not os.path.isfile(mpath):
            refusals.append("MANIFEST_MISSING %s" % rel)
            continue
        m = load_json(mpath)
        manifests.append({"rel": rel, "sha256": sha_file(mpath), "run": m.get("run"), "count": len(m.get("meshes", []))})
        if m.get("unreal_imported") is not False:
            refusals.append("MANIFEST_ALREADY_IMPORTED_OR_UNMARKED %s unreal_imported=%r" % (rel, m.get("unreal_imported")))
        if not m.get("meshes"):
            refusals.append("MANIFEST_EMPTY %s" % rel)
        for e in m.get("meshes", []):
            w = _wing(project, mi, e, record_hashes, refusals)
            if w is None:
                continue
            if w["owner"] in owners_seen:
                refusals.append("DUPLICATE_OWNER %s (%s and %s)" % (w["owner"], owners_seen[w["owner"]], rel))
                continue
            owners_seen[w["owner"]] = rel
            wings[w["owner"]] = w
    if batches is None:
        batches = auto_batches(wings)
    flat = [o for b in batches for o in b]
    if sorted(flat) != sorted(wings) or len(flat) != len(set(flat)):
        refusals.append("BATCHES_DO_NOT_COVER_OWNERS_ONCE")
    if any(len(b) > MAX_PER_BATCH or not b for b in batches):
        refusals.append("BATCH_TOO_BIG (max %d wings per MCP call)" % MAX_PER_BATCH)
    allpk = [p for w in wings.values() for p in w["packages"]]
    if len(allpk) != len(set(allpk)):
        refusals.append("DUPLICATE_DESTINATION")
    if any(not p.startswith(ROOT + "/") for p in allpk):
        refusals.append("DESTINATION_OUTSIDE_ROOT")
    p06_ledger = _abs(project, P06_LEDGER_REL)
    if os.path.isfile(p06_ledger):
        p06_saved = {p for b in load_json(p06_ledger).get("batches", {}).values() for p in b.get("saved", [])}
        clash = sorted(set(allpk) & p06_saved)
        if clash:
            refusals.append("DESTINATION_CLASH_WITH_P06_IMPORT %d %s" % (len(clash), clash[:3]))
    out_batches = []
    for k, b in enumerate(batches, 1):
        pk = sorted(p for o in b if o in wings for p in wings[o]["packages"])
        out_batches.append({"batch": k, "owners": list(b), "packages": pk,
                            "passages": sorted({wings[o]["passage"] for o in b if o in wings})})
    inputs = {"manifests": manifests,
              "wings": {k: {"sources": {s: v["sha256"] for s, v in w["sources"].items()},
                            "destinations": w["destinations"], "mount": w["mount"], "height_cm": w["height_cm"]}
                        for k, w in sorted(wings.items())},
              "batches": [list(b) for b in batches], "parents": PARENTS, "reference": REFERENCE,
              "aged_common_root": AGED_COMMON_ROOT, "texture_cmp": list(TEXTURE_CMP)}
    plan = {"mark": MARK, "manifests": manifests, "root": ROOT, "mesh_folders": MESH_FOLDERS,
            "wings": dict(sorted(wings.items())), "batches": out_batches, "package_count": len(allpk),
            "refusals": refusals, "mounts": sorted({w["mount"] for w in wings.values()}),
            "passages": sorted({w["passage"] for w in wings.values()}),
            "aged_common": {"root": AGED_COMMON_ROOT, "names": list(COMMON_AGED), "strategy": "REUSE_EXISTING"},
            "inputs_hash": sha_obj(inputs)}
    plan["hash8"] = plan["inputs_hash"][:8]
    plan["gates_ok"] = not refusals
    return plan


def mesh_paths(plan):
    """{owner: /Game mesh path} -- for rzswap (single source of truth for realism mesh names)."""
    return {w["owner"]: w["destinations"]["mesh"] for w in plan["wings"].values()}


