def expected_import_bounds(validation):
    """slot_a_import.expected_import_bounds [prec]: Interchange reflects FBX Y; X/Z keep their sign."""
    b = validation["bounds_m"]
    return ([b["min"][0] * 100.0, -b["max"][1] * 100.0, b["min"][2] * 100.0],
            [b["max"][0] * 100.0, -b["min"][1] * 100.0, b["max"][2] * 100.0])


def side_extension_ok(side, mn, mx):
    """slot_a verify_flat_general LEFT/RIGHT_SIDE_EXTENSION rule [prec] (wings only)."""
    if side == "L":
        return mn[1] >= -1.0 and mx[1] >= 100.0
    return mx[1] <= 1.0 and mn[1] <= -100.0


def height_gate(mount, bounds_cm, height_cm, pole):
    """Bounds Z vs the MANIFEST height.  Returns '' or the reason.
    wing: z = pole.bottom_z_cm .. height_cm + pole.top_above_panel_cm (sidecar baked_pole_geometry).
    top-border: z min ~ 0 and 0.5*height_cm <= z max <= height_cm (+ tol) [inf, see module doc]."""
    zmin, zmax = float(bounds_cm["min"][2]), float(bounds_cm["max"][2])
    h = float(height_cm)
    if mount == "wing":
        if not pole:
            return "HEIGHT_NO_POLE_GEOMETRY"
        want_min = float(pole["bottom_z_cm"])
        want_max = h + float(pole["top_above_panel_cm"])
        if abs(zmin - want_min) > BOUNDS_TOL_CM or abs(zmax - want_max) > BOUNDS_TOL_CM:
            return "HEIGHT_VS_MANIFEST z %.2f..%.2f want %.2f..%.2f" % (zmin, zmax, want_min, want_max)
        return ""
    if abs(zmin) > BOUNDS_TOL_CM or zmax > h + BOUNDS_TOL_CM or zmax < 0.5 * h:
        return "TOP_HEIGHT_VS_MANIFEST z %.2f..%.2f want 0..(<=%.2f, >=%.2f)" % (zmin, zmax, h, 0.5 * h)
    return ""


def top_centred_ok(mn, mx):
    return abs(float(mn[1]) + float(mx[1])) <= TOP_CENTRE_TOL_CM


def edge_geometry_ok(geom):
    """edge_rollout_core.geometry_ok [prec]: per LOD the Edge section spans x -15..-10, Front sits at x -15."""
    if not geom:
        return False, "NO_LODS"
    for row in geom:
        e, f = row.get("edge_x"), row.get("front_x")
        if e is None:
            return False, "LOD%d_NO_EDGE_SECTION" % row["lod"]
        if abs(e[0] - FRONT_X) > EDGE_TOL or abs(e[1] - BACK_X) > EDGE_TOL:
            return False, "LOD%d_EDGE_X_%.3f_%.3f_NOT_-15_-10" % (row["lod"], e[0], e[1])
        if f is None or abs(f[0] - FRONT_X) > EDGE_TOL or abs(f[1] - FRONT_X) > EDGE_TOL:
            return False, "LOD%d_FRONT_NOT_AT_X-15|%s" % (row["lod"], f)
    return True, ""


def census_exact(census, expected_content):
    """The only dirty packages allowed are exactly this batch's new packages; no map."""
    return census.get("maps") == [] and sorted(census.get("content", [])) == sorted(expected_content)


def geometry_verdict(w, m):
    """THE mount-aware mesh gate, pure (the Unreal entry measures, this decides; the harness drives it directly).
    m = {slots, num_lods, bounds_cm{min,max}, sockets{name:{location_cm, local_x_axis}}, nanite,
         lods{"0"/"1": {front:{du_dY,dv_dZ,normal}|None, flap:{..}|None, triangles, foot_y:[..]|None}}, edge_geometry}
    Returns [] or a list of failure strings.  Wing rules = slot_a verify_flat_general + the P06 kit's two measured
    changes (sidecar socket names, pivot at half the manifest height) [prec]; top-border = slot_a verify_top [decl]."""
    bad = []
    exp, asset, mount = w["expected"], w["asset"], w["mount"]
    if list(m.get("slots") or []) != list(SLOTS):
        bad.append("SLOT_ORDER_FAIL|%s|%s" % (asset, m.get("slots")))
    if m.get("num_lods") != 2:
        bad.append("LOD_COUNT_FAIL|%s|%s (FBX LodGroup not honoured?)" % (asset, m.get("num_lods")))
    mn, mx = m["bounds_cm"]["min"], m["bounds_cm"]["max"]
    if any(abs(a - b) > BOUNDS_TOL_CM for a, b in zip(list(mn) + list(mx),
                                                      exp["bounds_cm"]["min"] + exp["bounds_cm"]["max"])):
        bad.append("BOUNDS_MISMATCH|%s|%s|%s" % (asset, [mn, mx], exp["bounds_cm"]))
    hg = height_gate(mount, m["bounds_cm"], w["height_cm"], exp.get("pole"))
    if hg:
        bad.append("%s|%s" % (hg, asset))
    sockets = m.get("sockets") or {}
    if sorted(sockets) != sorted(exp["sockets"]):
        bad.append("SOCKET_NAMES_FAIL|%s|%s want %s" % (asset, sorted(sockets), exp["sockets"]))
    if mount == "wing":
        if not side_extension_ok(w["side"], mn, mx):
            bad.append("SIDE_EXTENSION_FAIL|%s|%s" % (asset, [mn[1], mx[1]]))
        hinge, pivot = sockets.get("SOCKET_Hinge"), sockets.get("SOCKET_Pivot")
        if hinge is None or max(abs(v) for v in hinge["location_cm"]) > 1.0 or abs(hinge["local_x_axis"][1]) < 0.99:
            bad.append("HINGE_SOCKET_FAIL|%s|%s" % (asset, hinge))
        if pivot is None or abs(pivot["location_cm"][0]) > 1.0 or \
                abs(pivot["location_cm"][2] - w["height_cm"] * 0.5) > PIVOT_TOL_CM or pivot["local_x_axis"][2] < 0.99:
            bad.append("PIVOT_SOCKET_FAIL|%s|%s" % (asset, pivot))
    else:
        if not top_centred_ok(mn, mx):
            bad.append("TOP_NOT_CENTRED_ON_Y|%s|%s" % (asset, [mn[1], mx[1]]))
        if sockets:
            bad.append("TOP_SOCKET_FAIL|%s|%s" % (asset, sorted(sockets)))
    poles = sorted(n for n in sockets if n.startswith("SOCKET_Pole_"))
    for lod in ("0", "1"):
        L = (m.get("lods") or {}).get(lod)
        if L is None:
            bad.append("LOD%s_NOT_MEASURED|%s" % (lod, asset))
            continue
        front, flap = L.get("front"), L.get("flap")
        if front is None or front["du_dY"] <= 0.0 or front["dv_dZ"] >= 0.0:     # V runs DOWN (ue58-fbx-import-traps)
            bad.append("FRONT_UV0_SIGN_FAIL|%s|lod%s|%s" % (asset, lod, front))
        elif front["normal"][0] > -0.99 or abs(front["normal"][1]) > 0.02 or abs(front["normal"][2]) > 0.02:
            bad.append("FRONT_NORMAL_FAIL|%s|lod%s|%s" % (asset, lod, front["normal"]))
        if lod == "0":
            if exp["expect_flap"] and (flap is None or flap["du_dY"] <= 0.0 or flap["dv_dZ"] >= 0.0):
                bad.append("FLAP_UV0_SIGN_FAIL|%s|%s" % (asset, flap))
            if not exp["expect_flap"] and flap is not None:
                bad.append("UNEXPECTED_FLAP_SECTION|%s (validator Flap triangles = 0)" % asset)
        elif flap is not None:
            bad.append("LOD1_FLAP_SURVIVED|%s" % asset)
        want = int(exp["triangles"]["lod" + lod])
        if abs(int(L.get("triangles", -10)) - want) > 1:      # slot_a's measured +-1 cross-importer variance [prec]
            bad.append("TRIANGLE_COUNT_FAIL|%s|lod%s|%s|%d" % (asset, lod, L.get("triangles"), want))
        if mount == "wing":
            feet = L.get("foot_y") or []
            if not feet:
                bad.append("BAKED_POLE_FOOT_VERTICES_MISSING|%s|lod%s" % (asset, lod))
            else:
                for name in poles:
                    y = sockets[name]["location_cm"][1]
                    if y < min(feet) - 2.0 or y > max(feet) + 2.0:
                        bad.append("POLE_SOCKET_OUTSIDE_FOOT_RANGE|%s|lod%s|%s|%g" % (asset, lod, name, y))
    if m.get("nanite"):
        bad.append("NANITE_ENABLED|%s" % asset)
    ok, why = edge_geometry_ok(m.get("edge_geometry"))
    if not ok:
        bad.append("EDGE_GEOMETRY_FAIL|%s|%s" % (asset, why))
    return bad


