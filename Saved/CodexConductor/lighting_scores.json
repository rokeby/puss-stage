{
 "schema_version": 1,
 "about": "Per-passage lighting SCORES over the one P04 kit (looks are presets; a passage is a score of looks per bay over distance, with pools and gaps). Bays are WingPair ORDINALS inside the passage's PassageSettings range; the tool resolves ordinal -> CueGuid at run time from that range (never by label: P05 reuses labels). Tool: lighting_scores_apply.py. Plan: Docs/Conductor/LIGHTING_SCORES_PLAN_2026-10-04.md.",
 "base_looks_source": "lighting_looks.json",
 "base_looks_used": [
  "MOODY",
  "INDUSTRIAL",
  "THEATRICAL"
 ],
 "base_looks_sha256_pin": null,
 "base_looks_pin_note": "null = inherit whatever lighting_looks.json holds at run time (tune 4 is editing the P04 prototype tonight). Pin the sha256 the DRY report prints once tune 4 lands and Gary has seen the P01-P06 dry-runs.",
 "fixture_label_prefix_format": "P%02d SCORE",
 "forbidden_looks": [
  "WASH",
  "SPOT"
 ],
 "forbidden_looks_note": "Gary: rarely washed out. WASH and SPOT are defined vocabulary but unassigned; the validator refuses them in any score.",
 "existing_light_policy": "disable_all_in_target_bay_except_retained",
 "foreign_owned_lights": [
  {
   "passage": "P01",
   "bay": 1,
   "label_suffix": " House L",
   "owner": "opening_sequence_apply.py",
   "decision": "Gary 4 Oct: house warmers OFF FOR THE OPENING ONLY, ON in P01 (opening_timing.json house_warmers)"
  },
  {
   "passage": "P01",
   "bay": 1,
   "label_suffix": " House R",
   "owner": "opening_sequence_apply.py",
   "decision": "as House L"
  }
 ],
