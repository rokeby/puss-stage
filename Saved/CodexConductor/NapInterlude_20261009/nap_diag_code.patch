+def seam_diagnostics(keys, loop_frames, tolerance=1.0e-4):
+    """Expose the exact values used by ``seam_failures`` without changing them."""
+    by_frame = {int(row[0]): float(row[1]) for row in keys}
+    frames = sorted(by_frame)
+    first_pair = frames[:2]
+    implementation_last_pair = frames[-2:]
+    loop_frames_present = [frame for frame in frames if frame <= int(loop_frames)]
+    loop_last_pair = loop_frames_present[-2:]
+
+    def pair_report(pair):
+        if len(pair) != 2:
+            return None
+        a, b = pair
+        return {"frames": [a, b], "values": [by_frame[a], by_frame[b]],
+                "slope": (by_frame[b] - by_frame[a]) / float(b - a)}
+
+    first = pair_report(first_pair)
+    implementation_last = pair_report(implementation_last_pair)
+    loop_last = pair_report(loop_last_pair)
+    return {
+        "loop_frame": int(loop_frames),
+        "tolerance": float(tolerance),
+        "all_keys": [[frame, by_frame[frame]] for frame in frames],
+        "loop_start_pair": first,
+        "loop_end_pair": loop_last,
+        "implementation_last_pair": implementation_last,
+        "implementation_slope_delta": (
+            abs(first["slope"] - implementation_last["slope"])
+            if first and implementation_last else None),
+        "loop_slope_delta": (
+            abs(first["slope"] - loop_last["slope"])
+            if first and loop_last else None),
+        "implementation_uses_tail_key": bool(frames and frames[-1] > int(loop_frames)),
+        "failures": seam_failures(keys, loop_frames, tolerance),
+    }
+
