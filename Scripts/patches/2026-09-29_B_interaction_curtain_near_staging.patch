--- a/Plugins/InfinityStage/Source/InfinityStageEditor/Private/InfinityStageEditorAutomationTests.cpp
+++ b/Plugins/InfinityStage/Source/InfinityStageEditor/Private/InfinityStageEditorAutomationTests.cpp
@@ -1045,12 +1045,48 @@ bool FInfinityStageSavedFixturePIETest::RunTest(const FString& Parameters)
             SequenceCurtainRig->Tick(0.0f);
             TestTrue(TEXT("Interaction sequence is fully lowered at its hidden-changeover marker"),
                 FMath::IsNearlyEqual(SequenceCurtainRig->CurtainProgress, 1.0f));
-            TestTrue(TEXT("Interaction curtain is placed beyond the near-camera placeholder distance"),
-                SequenceCurtainRig->CurtainDistanceCm >= 1000.0f);
-            TestTrue(TEXT("Interaction curtain closed transform supplies full-frame scale margin"),
-                SequenceCurtainRig->CurtainClosedRelativeTransform.GetScale3D().GetAbsMax() >= 3.0);
-            TestTrue(TEXT("Interaction curtain closed transform compensates its bottom pivot"),
-                SequenceCurtainRig->CurtainClosedRelativeTransform.GetTranslation().Z <= -1500.0);
+            // The curtain must hide the Passage it reveals: every corner of the 16:9 view has to meet it nearer
+            // than the first Wing pair (station 1 stands 250 cm into a Passage), or the Passage is seen before the
+            // curtain lifts. Until 29 Sep this asserted a 1500 cm staging, which stood behind three Wing pairs.
+            constexpr double FirstWingPairCm = 250.0;
+            constexpr double ShowAspectRatio = 16.0 / 9.0;
+            const APlayerCameraManager* CurtainCamera = PlayerController ? PlayerController->PlayerCameraManager.Get() : nullptr;
+            const UStaticMesh* CoverMesh = SequenceCurtainRig->CurtainMesh ? SequenceCurtainRig->CurtainMesh->GetStaticMesh() : nullptr;
+            TestNotNull(TEXT("Interaction curtain has a camera to cover"), CurtainCamera);
+            if (CurtainCamera && CoverMesh)
+            {
+                const FVector Eye = CurtainCamera->GetCameraLocation();
+                const FRotator ViewRotation = CurtainCamera->GetCameraRotation();
+                const double HalfWidth = FMath::Tan(FMath::DegreesToRadians(CurtainCamera->GetFOVAngle() * 0.5));
+                const double HalfHeight = HalfWidth / ShowAspectRatio;
+                const FTransform MeshToWorld = SequenceCurtainRig->CurtainMesh->GetComponentTransform();
+                const FBox LocalBox = CoverMesh->GetBoundingBox();
+                const FVector Forward = ViewRotation.Vector();
+                double FarthestCm = 0.0;
+                for (int32 Corner = 0; Corner < 8; ++Corner)
+                {
+                    const FVector LocalCorner(
+                        (Corner & 1) ? LocalBox.Max.X : LocalBox.Min.X,
+                        (Corner & 2) ? LocalBox.Max.Y : LocalBox.Min.Y,
+                        (Corner & 4) ? LocalBox.Max.Z : LocalBox.Min.Z);
+                    FarthestCm = FMath::Max(FarthestCm,
+                        FVector::DotProduct(MeshToWorld.TransformPosition(LocalCorner) - Eye, Forward));
+                }
+                TestTrue(FString::Printf(TEXT("Interaction curtain stands nearer than the first Wing pair (%.1f cm < %.0f cm)"),
+                    FarthestCm, FirstWingPairCm), FarthestCm < FirstWingPairCm);
+                const FVector2D ViewPoints[] = { FVector2D(0.0, 0.0), FVector2D(-1.0, -1.0), FVector2D(1.0, -1.0),
+                    FVector2D(-1.0, 1.0), FVector2D(1.0, 1.0) };
+                const FVector LocalEye = MeshToWorld.InverseTransformPosition(Eye);
+                int32 CoveredPoints = 0;
+                for (const FVector2D& Point : ViewPoints)
+                {
+                    const FVector Direction = ViewRotation.RotateVector(
+                        FVector(1.0, Point.X * HalfWidth, Point.Y * HalfHeight)).GetSafeNormal();
+                    const FVector LocalEnd = MeshToWorld.InverseTransformPosition(Eye + Direction * FirstWingPairCm);
+                    CoveredPoints += FMath::LineBoxIntersection(LocalBox, LocalEye, LocalEnd, LocalEnd - LocalEye) ? 1 : 0;
+                }
+                TestEqual(TEXT("Interaction curtain covers the centre and every corner of the 16:9 view"), CoveredPoints, 5);
+            }
             TestTrue(TEXT("Interaction curtain keeps a safety hold after hidden changeover"),
                 ShowRoot->Transport->Segments[3].CoveredHandoffFrame
                     < ShowRoot->Transport->Segments[3].StartFrame + FFrameNumber(384000));
