+double AInfinityStageCameraRig::StepGaitRollBaseline(
+    double& InOutMeanCm,
+    bool& bInOutPrimed,
+    const double LiftCm,
+    const double DeltaSeconds,
+    const double TauSeconds,
+    const double MaxGapSeconds)
+{
+    if (!bInOutPrimed || DeltaSeconds < 0.0 || DeltaSeconds > MaxGapSeconds)
+    {
+        InOutMeanCm = LiftCm;
+        bInOutPrimed = true;
+        return 0.0;
+    }
+    const double Alpha = TauSeconds > UE_DOUBLE_SMALL_NUMBER ? 1.0 - FMath::Exp(-DeltaSeconds / TauSeconds) : 1.0;
+    InOutMeanCm += (LiftCm - InOutMeanCm) * Alpha;
+    return LiftCm - InOutMeanCm;
+}
