diff --git a/Plugins/InfinityStage/Source/InfinityStageTests/Private/InfinityStageGaitRollTests.cpp b/Plugins/InfinityStage/Source/InfinityStageTests/Private/InfinityStageGaitRollTests.cpp
new file mode 100644
index 0000000..69b08fb
--- /dev/null
+++ b/Plugins/InfinityStage/Source/InfinityStageTests/Private/InfinityStageGaitRollTests.cpp
@@ -0,0 +1,96 @@
+#include "InfinityStageCameraRig.h"
+#include "Misc/AutomationTest.h"
+
+#if WITH_DEV_AUTOMATION_TESTS
+
+/**
+ * The gait roll is centred on the lift's running mean, never on its absolute value.
+ *
+ * A walking cat sits below its bind pose, so the lift never goes positive
+ * (measured 30 Sep: -7 to -23 cm over P04's last 1.9 s), and a roll taken from
+ * the lift itself tilted the camera 1-3 degrees to one side for a whole Passage.
+ * Gary (30 Sep): "no need to permanently tilt and the camera is at an ok height
+ * as it is", so the height keeps the lift and only the roll is centred. The
+ * baseline is a pure step function so this runs without a world. Red without the
+ * fix: StepGaitRollBaseline does not exist, and the old rule's roll input (the
+ * lift itself) is one-sided, as the last assertion states.
+ */
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(
+    FInfinityStageGaitRollCentredTest,
+    "InfinityStage.ShadowCat.GaitRollCentredOnRunningMean",
+    EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)
+
+bool FInfinityStageGaitRollCentredTest::RunTest(const FString& Parameters)
+{
+    constexpr double Dt = 1.0 / 30.0;
+    constexpr double Tau = 1.0;
+
+    // A constant (biased) lift holds no roll: first sample primes, then the deviation stays ~0.
+    {
+        double Mean = 0.0;
+        bool bPrimed = false;
+        double MaxAbs = 0.0;
+        TestEqual(TEXT("The first sample primes the mean and returns no roll"),
+            AInfinityStageCameraRig::StepGaitRollBaseline(Mean, bPrimed, -15.0, 0.0, Tau), 0.0);
+        for (int32 Step = 0; Step < 150; ++Step)
+        {
+            MaxAbs = FMath::Max(MaxAbs, FMath::Abs(AInfinityStageCameraRig::StepGaitRollBaseline(Mean, bPrimed, -15.0, Dt, Tau)));
+        }
+        TestTrue(FString::Printf(TEXT("A constant -15 cm lift holds no roll (max |deviation| %.4f cm)"), MaxAbs), MaxAbs < 1.0e-6);
+        TestEqual(TEXT("The mean sits on the constant lift"), Mean, -15.0, 1.0e-6);
+    }
+
+    // A biased gait (-15 +/- 8 cm, 0.6 s stride) rolls BOTH ways about zero once settled.
+    {
+        double Mean = 0.0;
+        bool bPrimed = false;
+        double MinDev = 0.0;
+        double MaxDev = 0.0;
+        double SumDev = 0.0;
+        double MinLift = 0.0;
+        double MaxLift = -100.0;
+        int32 Settled = 0;
+        for (int32 Step = 0; Step <= 300; ++Step)
+        {
+            const double Seconds = Step * Dt;
+            const double Lift = -15.0 + 8.0 * FMath::Sin(2.0 * UE_DOUBLE_PI * Seconds / 0.6);
+            const double Deviation = AInfinityStageCameraRig::StepGaitRollBaseline(Mean, bPrimed, Lift, Step == 0 ? 0.0 : Dt, Tau);
+            if (Seconds >= 5.0)
+            {
+                MinDev = FMath::Min(MinDev, Deviation);
+                MaxDev = FMath::Max(MaxDev, Deviation);
+                SumDev += Deviation;
+                MinLift = FMath::Min(MinLift, Lift);
+                MaxLift = FMath::Max(MaxLift, Lift);
+                ++Settled;
+            }
+        }
+        TestTrue(FString::Printf(TEXT("The roll swings both ways (deviation %.2f..%.2f cm)"), MinDev, MaxDev),
+            MinDev < -5.0 && MaxDev > 5.0);
+        TestTrue(FString::Printf(TEXT("The roll averages about zero (mean deviation %.3f cm)"), SumDev / FMath::Max(1, Settled)),
+            FMath::Abs(SumDev / FMath::Max(1, Settled)) < 1.0);
+        TestTrue(FString::Printf(TEXT("The old rule's input, the lift itself, was one-sided (%.2f..%.2f cm)"), MinLift, MaxLift),
+            MaxLift < 0.0);
+    }
+
+    // A jump (a long gap) re-primes: no kick when a Passage resumes somewhere else.
+    {
+        double Mean = 0.0;
+        bool bPrimed = false;
+        AInfinityStageCameraRig::StepGaitRollBaseline(Mean, bPrimed, -15.0, 0.0, Tau);
+        for (int32 Step = 0; Step < 60; ++Step)
+        {
+            AInfinityStageCameraRig::StepGaitRollBaseline(Mean, bPrimed, -15.0, Dt, Tau);
+        }
+        TestEqual(TEXT("A 2 s gap re-primes on the new lift: no roll kick"),
+            AInfinityStageCameraRig::StepGaitRollBaseline(Mean, bPrimed, -5.0, 2.0, Tau), 0.0);
+        TestEqual(TEXT("A backwards step (a reverse scrub) re-primes too"),
+            AInfinityStageCameraRig::StepGaitRollBaseline(Mean, bPrimed, -9.0, -0.1, Tau), 0.0);
+        const double Before = Mean;
+        AInfinityStageCameraRig::StepGaitRollBaseline(Mean, bPrimed, -20.0, 0.0, Tau);
+        TestEqual(TEXT("A zero step (a second evaluation in the same frame) leaves the mean alone"), Mean, Before);
+    }
+    return true;
+}
+
+#endif
