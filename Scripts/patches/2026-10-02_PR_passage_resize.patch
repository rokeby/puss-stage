+namespace
+{
+constexpr double DurationToleranceSeconds = 0.0005;
+constexpr double DistanceToleranceCm = 0.01;
+
+const FInfinityCompiledPassage* FindCompiledPassage(
+    const FInfinityCompileResult& Compiled,
+    const FGuid PassageGuid)
+{
+    return Compiled.Passages.FindByPredicate([PassageGuid](const FInfinityCompiledPassage& Candidate)
+    {
+        return Candidate.PassageGuid == PassageGuid;
+    });
+}
+
+FInfinityPassageSettings* FindSettings(UInfinityStageShowAsset& Show, const FGuid PassageGuid)
+{
+    return Show.PassageSettings.FindByPredicate([PassageGuid](const FInfinityPassageSettings& Candidate)
+    {
+        return Candidate.PassageGuid == PassageGuid;
+    });
+}
+
+const FInfinityPassageSettings* FindSettings(const UInfinityStageShowAsset& Show, const FGuid PassageGuid)
+{
+    return Show.PassageSettings.FindByPredicate([PassageGuid](const FInfinityPassageSettings& Candidate)
+    {
+        return Candidate.PassageGuid == PassageGuid;
+    });
+}
+
+AInfinityStagePassageActor* FindPassageActor(
+    UWorld* World,
+    const UInfinityStageShowAsset* Show,
+    const FGuid PassageGuid)
+{
+    if (!World)
+    {
+        return nullptr;
+    }
+    for (TActorIterator<AInfinityStagePassageActor> It(World); It; ++It)
+    {
+        if (It->ShowAsset == Show && It->PassageGuid == PassageGuid)
+        {
+            return *It;
+        }
+    }
+    return nullptr;
+}
+
+bool IsShapedRoute(const USplineComponent& Route)
+{
+    const int32 PointCount = Route.GetNumberOfSplinePoints();
+    if (PointCount > 2)
+    {
+        return true;
+    }
+    for (int32 PointIndex = 0; PointIndex < PointCount; ++PointIndex)
+    {
+        const FVector Location = Route.GetLocationAtSplinePoint(PointIndex, ESplineCoordinateSpace::Local);
+        if (FMath::Abs(Location.Y) > 1.0 || FMath::Abs(Location.Z) > 1.0)
+        {
+            return true;
+        }
+    }
+    return false;
+}
+
+FBox RouteWorldExtent(const AInfinityStagePassageActor& Actor, const double RequiredDistanceCm)
+{
+    FBox Bounds(EForceInit::ForceInit);
+    if (!Actor.Route)
+    {
+        return Bounds;
+    }
+    const double SplineLengthCm = Actor.Route->GetSplineLength();
+    const double SampledDistanceCm = FMath::Min(RequiredDistanceCm, SplineLengthCm);
+    constexpr int32 SampleCount = 32;
+    for (int32 Index = 0; Index <= SampleCount; ++Index)
+    {
+        const double DistanceCm = SampledDistanceCm * static_cast<double>(Index) / SampleCount;
+        Bounds += Actor.Route->GetLocationAtDistanceAlongSpline(DistanceCm, ESplineCoordinateSpace::World);
+    }
+    if (RequiredDistanceCm > SplineLengthCm && !IsShapedRoute(*Actor.Route))
+    {
+        const FVector End = Actor.Route->GetLocationAtDistanceAlongSpline(
+            SplineLengthCm,
+            ESplineCoordinateSpace::World);
+        const FVector Direction = Actor.Route->GetDirectionAtDistanceAlongSpline(
+            SplineLengthCm,
+            ESplineCoordinateSpace::World).GetSafeNormal();
+        Bounds += End + Direction * (RequiredDistanceCm - SplineLengthCm);
+    }
+    return Bounds.ExpandBy(1.0);
+}
+
+bool IsManagedTrackForShow(const UMovieSceneTrack& Track, const FGuid ShowGuid)
+{
+    if (const UMovieSceneInfinityPassageTrack* Passage = Cast<UMovieSceneInfinityPassageTrack>(&Track))
+    {
+        return Passage->OwnerGuid == ShowGuid;
+    }
+    if (const UMovieSceneInfinitySceneTrack* Scene = Cast<UMovieSceneInfinitySceneTrack>(&Track))
+    {
+        return Scene->OwnerGuid == ShowGuid;
+    }
+    if (const UMovieSceneInfinityAudioTrack* Audio = Cast<UMovieSceneInfinityAudioTrack>(&Track))
+    {
+        return Audio->OwnerGuid == ShowGuid;
+    }
+    return false;
+}
+
+void RecordArtistOwnedContent(
+    const UInfinityStageShowAsset& Show,
+    const ULevelSequence* MasterSequence,
+    TArray<FString>& OutItems)
+{
+    OutItems.Reset();
+    const UMovieScene* MovieScene = MasterSequence ? MasterSequence->GetMovieScene() : nullptr;
+    if (!MovieScene)
+    {
+        OutItems.Add(TEXT("UNCLEAR: no Master Movie Scene was supplied; artist content was not inspected."));
+        return;
+    }
+    for (const FMovieSceneMarkedFrame& Marker : MovieScene->GetMarkedFrames())
+    {
+        OutItems.Add(FString::Printf(
+            TEXT("marker label='%s' frame=%d"),
+            *Marker.Label,
+            Marker.FrameNumber.Value));
+    }
+    for (const UMovieSceneTrack* Track : MovieScene->GetTracks())
+    {
+        if (!Track || IsManagedTrackForShow(*Track, Show.ShowGuid))
+        {
+            continue;
+        }
+        int32 KeyCount = 0;
+        for (const UMovieSceneSection* Section : Track->GetAllSections())
+        {
+            if (!Section)
+            {
+                continue;
+            }
+            for (const FMovieSceneChannelEntry& Entry : Section->GetChannelProxy().GetAllEntries())
+            {
+                for (const FMovieSceneChannel* Channel : Entry.GetChannels())
+                {
+                    KeyCount += Channel ? Channel->GetNumKeys() : 0;
+                }
+            }
+        }
+        OutItems.Add(FString::Printf(
+            TEXT("track='%s' class=%s sections=%d keys=%d"),
+            *Track->GetDisplayName().ToString(),
+            *Track->GetClass()->GetName(),
+            Track->GetAllSections().Num(),
+            KeyCount));
+    }
+}
+
+void AddManagedMoves(
+    const FInfinityCompileResult& Before,
+    const FInfinityCompileResult& After,
+    TArray<FInfinityPassageManagedSectionMove>& OutMoves)
+{
+    OutMoves.Reset();
+    for (const FInfinityCompiledPassage& OldPassage : Before.Passages)
+    {
+        const FInfinityCompiledPassage* NewPassage = FindCompiledPassage(After, OldPassage.PassageGuid);
+        if (!NewPassage || (OldPassage.SegmentStartFrame == NewPassage->SegmentStartFrame
+            && OldPassage.SegmentEndFrame == NewPassage->SegmentEndFrame))
+        {
+            continue;
+        }
+        FInfinityPassageManagedSectionMove& Move = OutMoves.AddDefaulted_GetRef();
+        Move.Kind = TEXT("Passage");
+        Move.BlockGuid = OldPassage.PassageGuid;
+        Move.OldStartFrame = OldPassage.SegmentStartFrame;
+        Move.NewStartFrame = NewPassage->SegmentStartFrame;
+        Move.OldEndFrame = OldPassage.SegmentEndFrame;
+        Move.NewEndFrame = NewPassage->SegmentEndFrame;
+    }
+    for (const FInfinityCompiledSegment& OldSegment : Before.Segments)
+    {
+        const FInfinityCompiledSegment* NewSegment = After.Segments.FindByPredicate(
+            [&OldSegment](const FInfinityCompiledSegment& Candidate)
+            {
+                return Candidate.SegmentGuid == OldSegment.SegmentGuid;
+            });
+        if (!NewSegment || (OldSegment.StartFrame == NewSegment->StartFrame
+            && OldSegment.EndFrame == NewSegment->EndFrame))
+        {
+            continue;
+        }
+        FInfinityPassageManagedSectionMove& Move = OutMoves.AddDefaulted_GetRef();
+        Move.Kind = TEXT("SceneOrSequence");
+        Move.BlockGuid = OldSegment.SegmentGuid;
+        Move.OldStartFrame = OldSegment.StartFrame;
+        Move.NewStartFrame = NewSegment->StartFrame;
+        Move.OldEndFrame = OldSegment.EndFrame;
+        Move.NewEndFrame = NewSegment->EndFrame;
+    }
+}
+
+bool ApplyResizeData(
+    UInfinityStageShowAsset& Show,
+    const FGuid PassageGuid,
+    const int32 DesiredCount,
+    const FFrameNumber IntervalFrames,
+    const FFrameNumber LeadFrames,
+    const FFrameNumber TailFrames,
+    const double SpacingCm,
+    const double TailDistanceCm,
+    FString& OutError)
+{
+    TArray<int32> AffectedIndices;
+    if (!FInfinityStageWingSequenceInterchange::ResizePassageToCountPreservingPattern(
+        Show,
+        PassageGuid,
+        DesiredCount,
+        IntervalFrames,
+        SpacingCm,
+        AffectedIndices,
+        OutError))
+    {
+        return false;
+    }
+    FInfinityPassageSettings* Settings = FindSettings(Show, PassageGuid);
+    if (!Settings)
+    {
+        OutError = TEXT("The resized Passage settings could not be recovered.");
+        return false;
+    }
+    Settings->FitMode = EInfinityPassageFitMode::ManualPassage;
+    Settings->LeadInFrames = LeadFrames;
+    Settings->TailFrames = TailFrames;
+    Settings->PreferredSpacingCm = SpacingCm;
+    Settings->TailDistanceCm = TailDistanceCm;
+    return true;
+}
+}
+
+FInfinityPassageResizePlan UInfinityStagePassageResizeLibrary::ResizePassageToDuration(
+    UInfinityStageShowAsset* Show,
+    UWorld* BindingWorld,
+    ULevelSequence* MasterSequence,
+    const FGuid PassageGuid,
+    const double TargetSeconds,
+    const EInfinityPassageResizePolicy Policy,
+    const bool bDryRun,
+    const bool bAcceptOverrideLoss)
+{
+    FInfinityPassageResizePlan Plan;
+    Plan.PassageGuid = PassageGuid;
+    Plan.TargetSeconds = TargetSeconds;
+    if (!Show)
+    {
+        Plan.RefusalReasons.Add(TEXT("Show is null."));
+        Plan.Report = TEXT("PASSAGE_RESIZE_REFUSED: Show is null.");
+        return Plan;
+    }
+    if (Policy != EInfinityPassageResizePolicy::PreserveSpeedAndSpacing)
+    {
+        Plan.RefusalReasons.Add(TEXT("Only PreserveSpeedAndSpacing is implemented."));
+    }
+    if (TargetSeconds <= 0.0 || Show->TickResolution.AsDecimal() <= 0.0)
+    {
+        Plan.RefusalReasons.Add(TEXT("Target duration and Show tick resolution must be positive."));
+    }
+
+    const FInfinityPassageSettings* Settings = FindSettings(*Show, PassageGuid);
+    const FInfinityCompileResult Before = FInfinityStageCompiler::Compile(*Show);
+    const FInfinityCompiledPassage* OldPassage = FindCompiledPassage(Before, PassageGuid);
+    if (!Settings || !OldPassage)
+    {
+        Plan.RefusalReasons.Add(TEXT("PassageGuid does not resolve to compiled Passage settings."));
+        Plan.Report = TEXT("PASSAGE_RESIZE_REFUSED: PassageGuid did not resolve.");
+        return Plan;
+    }
+    if (Before.HasErrors())
+    {
+        Plan.RefusalReasons.Add(TEXT("The source Show has compile errors."));
+    }
+
+    const int32 OldFirstIndex = OldPassage->FirstCueIndex;
+    const int32 OldLastIndex = OldPassage->LastCueIndex;
+    Plan.OldWingPairCount = OldPassage->Wings.Num();
+    const double TickRate = Show->TickResolution.AsDecimal();
+    Plan.OldDurationSeconds =
+        (OldPassage->SegmentEndFrame - OldPassage->SegmentStartFrame).Value / TickRate;
+    Plan.OldRouteLengthCm = OldPassage->TotalDistanceCm;
+
+    const int32 OverrideMask = static_cast<int32>(EInfinityLocalOverride::IntervalToNext)
+        | static_cast<int32>(EInfinityLocalOverride::GapToNext);
+    for (int32 Index = OldFirstIndex; Index <= OldLastIndex; ++Index)
+    {
+        if (Show->Cues.IsValidIndex(Index)
+            && (Show->Cues[Index].WingPair.LocalOverrideMask & OverrideMask) != 0)
+        {
+            Plan.LocalOverrideCueGuids.Add(Show->Cues[Index].CueGuid);
+            Plan.LocalOverrideRows.Add(FString::Printf(
+                TEXT("label='%s' guid=%s bits=%d"),
+                *Show->Cues[Index].Label.ToString(),
+                *Show->Cues[Index].CueGuid.ToString(EGuidFormats::DigitsWithHyphens),
+                Show->Cues[Index].WingPair.LocalOverrideMask));
+        }
+    }
+    if (!Plan.LocalOverrideCueGuids.IsEmpty() && !bAcceptOverrideLoss)
+    {
+        Plan.RefusalReasons.Add(FString::Printf(
+            TEXT("%d Wing Pair row(s) have local interval/gap overrides; pass bAcceptOverrideLoss=true to erase them."),
+            Plan.LocalOverrideCueGuids.Num()));
+    }
+
+    const int64 TargetFrame64 = FMath::RoundToInt64(TargetSeconds * TickRate);
+    if (TargetFrame64 < 1 || TargetFrame64 > MAX_int32)
+    {
+        Plan.RefusalReasons.Add(TEXT("Target duration is outside the supported frame range."));
+        Plan.Report = TEXT("PASSAGE_RESIZE_REFUSED: invalid target frame.");
+        return Plan;
+    }
+    const FFrameNumber TargetFrames(static_cast<int32>(TargetFrame64));
+    const double RepresentedTargetSeconds = TargetFrames.Value / TickRate;
+    if (!FMath::IsNearlyEqual(RepresentedTargetSeconds, TargetSeconds, DurationToleranceSeconds))
+    {
+        Plan.RefusalReasons.Add(TEXT("Target duration is not exactly representable to three decimals at this tick resolution."));
+    }
+
+    const FInfinityPassageFitResult Fit = FInfinityStageCompiler::FitPassage({
+        TargetSeconds,
+        Settings->PreferredCameraSpeedCmPerSecond,
+        Settings->PreferredSpacingCm,
+        Settings->LeadInDistanceCm,
+        Settings->TailDistanceCm});
+    if (!Fit.bValid)
+    {
+        Plan.RefusalReasons.Add(Fit.Error);
+        Plan.Report = FString::Printf(TEXT("PASSAGE_RESIZE_REFUSED: %s"), *Fit.Error);
+        return Plan;
+    }
+    Plan.NewWingPairCount = Fit.WingPairCount;
+    Plan.PairsAppended = FMath::Max(0, Plan.NewWingPairCount - Plan.OldWingPairCount);
+
+    const FFrameNumber IntervalFrames(FMath::Max(1, FMath::RoundToInt(
+        (Settings->PreferredSpacingCm / Settings->PreferredCameraSpeedCmPerSecond) * TickRate)));
+    const FFrameNumber LeadFrames(FMath::Max(0, FMath::RoundToInt(
+        (Settings->LeadInDistanceCm / Settings->PreferredCameraSpeedCmPerSecond) * TickRate)));
+    const int64 TailFrame64 = TargetFrames.Value - LeadFrames.Value
+        - static_cast<int64>(Plan.NewWingPairCount - 1) * IntervalFrames.Value;
+    if (TailFrame64 < 0 || TailFrame64 > MAX_int32)
+    {
+        Plan.RefusalReasons.Add(TEXT("The frame residual cannot close in a non-negative TailFrames value."));
+        Plan.Report = TEXT("PASSAGE_RESIZE_REFUSED: frame residual did not close.");
+        return Plan;
+    }
+    Plan.NewTailFrames = FFrameNumber(static_cast<int32>(TailFrame64));
+    Plan.NewTailDistanceCm = Plan.NewTailFrames.Value / TickRate
+        * Settings->PreferredCameraSpeedCmPerSecond;
+    Plan.ResidualDistanceAbsorbedCm = Plan.NewTailDistanceCm - Settings->TailDistanceCm;
+
+    UInfinityStageShowAsset* PlannedShow = DuplicateObject<UInfinityStageShowAsset>(Show, GetTransientPackage());
+    FString ResizeReport;
+    if (!PlannedShow || !ApplyResizeData(
+        *PlannedShow,
+        PassageGuid,
+        Plan.NewWingPairCount,
+        IntervalFrames,
+        LeadFrames,
+        Plan.NewTailFrames,
+        Settings->PreferredSpacingCm,
+        Plan.NewTailDistanceCm,
+        ResizeReport))
+    {
+        Plan.RefusalReasons.Add(ResizeReport.IsEmpty()
+            ? TEXT("The side-effect-free resize simulation failed.")
+            : ResizeReport);
+        Plan.Report = TEXT("PASSAGE_RESIZE_REFUSED: resize simulation failed.");
+        return Plan;
+    }
+
+    const FInfinityCompileResult After = FInfinityStageCompiler::Compile(*PlannedShow);
+    const FInfinityCompiledPassage* NewPassage = FindCompiledPassage(After, PassageGuid);
+    if (After.HasErrors() || !NewPassage)
+    {
+        Plan.RefusalReasons.Add(TEXT("The resized Show does not compile cleanly."));
+        Plan.Report = TEXT("PASSAGE_RESIZE_REFUSED: resized Show did not compile.");
+        return Plan;
+    }
+    Plan.NewDurationSeconds =
+        (NewPassage->SegmentEndFrame - NewPassage->SegmentStartFrame).Value / TickRate;
+    Plan.NewRouteLengthCm = NewPassage->TotalDistanceCm;
+    if (!FMath::IsNearlyEqual(Plan.NewDurationSeconds, TargetSeconds, DurationToleranceSeconds))
+    {
+        Plan.RefusalReasons.Add(FString::Printf(
+            TEXT("Residual did not close: compiled %.9f s, requested %.9f s."),
+            Plan.NewDurationSeconds,
+            TargetSeconds));
+    }
+
+    for (int32 OldIndex = OldLastIndex + 1; OldIndex < Show->Cues.Num(); ++OldIndex)
+    {
+        const FGuid CueGuid = Show->Cues[OldIndex].CueGuid;
+        const int32 NewIndex = PlannedShow->FindCueIndex(CueGuid);
+        FInfinityPassageCueIndexShift& Shift = Plan.LaterCueIndexShifts.AddDefaulted_GetRef();
+        Shift.CueGuid = CueGuid;
+        Shift.OldIndex = OldIndex;
+        Shift.NewIndex = NewIndex;
+        if (NewIndex == INDEX_NONE)
+        {
+            Plan.RefusalReasons.Add(FString::Printf(
+                TEXT("Later cue %s disappeared during the resize simulation."),
+                *CueGuid.ToString(EGuidFormats::DigitsWithHyphens)));
+        }
+    }
+    if (!Plan.LaterCueIndexShifts.IsEmpty())
+    {
+        Plan.Warnings.Add(TEXT("Regenerate all external index+GUID swap plans, including Wings and Textures, after APPLY."));
+    }
+    Plan.MasterPlaybackRangeDelta = After.ShowEndFrame - Before.ShowEndFrame;
+    AddManagedMoves(Before, After, Plan.ManagedSectionsMoving);
+    RecordArtistOwnedContent(*Show, MasterSequence, Plan.ArtistOwnedMasterContentNotRippled);
+
+    AInfinityStagePassageActor* PassageActor = FindPassageActor(BindingWorld, Show, PassageGuid);
+    if (!PassageActor || !PassageActor->Route)
+    {
+        Plan.RefusalReasons.Add(TEXT("No matching Passage actor/route exists in BindingWorld; physical extent is unverified."));
+    }
+    else
+    {
+        Plan.RouteSplineLengthCm = PassageActor->Route->GetSplineLength();
+        Plan.bRouteIsShaped = IsShapedRoute(*PassageActor->Route);
+        const FBox OldExtent = RouteWorldExtent(*PassageActor, Plan.OldRouteLengthCm);
+        const FBox NewExtent = RouteWorldExtent(*PassageActor, Plan.NewRouteLengthCm);
+        if (OldExtent.IsValid)
+        {
+            Plan.OldWorldExtentMin = OldExtent.Min;
+            Plan.OldWorldExtentMax = OldExtent.Max;
+        }
+        if (NewExtent.IsValid)
+        {
+            Plan.NewWorldExtentMin = NewExtent.Min;
+            Plan.NewWorldExtentMax = NewExtent.Max;
+        }
+        const bool bRouteShort =
+            Plan.RouteSplineLengthCm + DistanceToleranceCm < Plan.NewRouteLengthCm;
+        if (bRouteShort && Plan.bRouteIsShaped)
+        {
+            Plan.RefusalReasons.Add(FString::Printf(
+                TEXT("Shaped route is %.3f cm; %.3f cm is required and Auto Fit would overwrite it."),
+                Plan.RouteSplineLengthCm,
+                Plan.NewRouteLengthCm));
+        }
+        else if (bRouteShort && !PassageActor->bAutoFitStraightRoute)
+        {
+            Plan.RefusalReasons.Add(FString::Printf(
+                TEXT("Route is %.3f cm; %.3f cm is required and Auto Fit is disabled."),
+                Plan.RouteSplineLengthCm,
+                Plan.NewRouteLengthCm));
+        }
+
+        if (NewExtent.IsValid)
+        {
+            for (TActorIterator<AActor> It(BindingWorld); It; ++It)
+            {
+                AActor* Other = *It;
+                if (!Other || Other == PassageActor)
+                {
+                    continue;
+                }
+                const bool bNeighbourPassage = Other->IsA<AInfinityStagePassageActor>();
+                const bool bHangar = Other->ActorHasTag(FName(TEXT("RigAtmos.Hangar")));
+                if (!bNeighbourPassage && !bHangar)
+                {
+                    continue;
+                }
+                const FBox OtherBounds = Other->GetComponentsBoundingBox(true);
+                if (OtherBounds.IsValid && NewExtent.Intersect(OtherBounds)
+                    && (!OldExtent.IsValid || !OldExtent.Intersect(OtherBounds)))
+                {
+                    Plan.OverlapActors.AddUnique(Other->GetActorLabel());
+                }
+            }
+        }
+        if (!Plan.OverlapActors.IsEmpty())
+        {
+            Plan.RefusalReasons.Add(FString::Printf(
+                TEXT("The added world extent overlaps %d neighbouring Passage/hangar actor(s)."),
+                Plan.OverlapActors.Num()));
+        }
+    }
+
+    Plan.bCanApply = Plan.RefusalReasons.IsEmpty();
+    if (!bDryRun && Plan.bCanApply)
+    {
+        const FScopedTransaction Transaction(NSLOCTEXT(
+            "InfinityStage",
+            "ResizePassageToDurationTransaction",
+            "Resize Passage To Duration"));
+        Show->Modify();
+        FString ApplyReport;
+        if (!ApplyResizeData(
+            *Show,
+            PassageGuid,
+            Plan.NewWingPairCount,
+            IntervalFrames,
+            LeadFrames,
+            Plan.NewTailFrames,
+            Settings->PreferredSpacingCm,
+            Plan.NewTailDistanceCm,
+            ApplyReport))
+        {
+            Plan.bCanApply = false;
+            Plan.RefusalReasons.Add(ApplyReport);
+        }
+        else
+        {
+            Show->MarkPackageDirty();
+            Plan.bApplied = true;
+            Plan.Warnings.Add(TEXT(
+                "Show data changed only: materialize this Passage, rebuild the Master, rematch the following Scene, then targeted-save and read back."));
+        }
+    }
+
+    Plan.Report = FString::Printf(
+        TEXT("PASSAGE_RESIZE_%s passage=%s old_count=%d new_count=%d appended=%d old_s=%.3f new_s=%.3f old_cm=%.3f new_cm=%.3f master_delta=%d refusals=%d artist_items=%d"),
+        Plan.bApplied ? TEXT("APPLIED") : (Plan.bCanApply ? TEXT("DRY_OK") : TEXT("REFUSED")),
+        *PassageGuid.ToString(EGuidFormats::DigitsWithHyphens),
+        Plan.OldWingPairCount,
+        Plan.NewWingPairCount,
+        Plan.PairsAppended,
+        Plan.OldDurationSeconds,
+        Plan.NewDurationSeconds,
+        Plan.OldRouteLengthCm,
+        Plan.NewRouteLengthCm,
+        Plan.MasterPlaybackRangeDelta.Value,
+        Plan.RefusalReasons.Num(),
+        Plan.ArtistOwnedMasterContentNotRippled.Num());
+    return Plan;
+}
