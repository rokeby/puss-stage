+        // 5 Oct: the curtain sleight gives an Interaction TWO cuts in one cut track, a hangar camera then the
+        // matched mouth camera (Saved/CodexConductor/curtain_sleight.py; tags CurtainSleight + CurtainSleight.I<N>).
+        // Which camera owns a frame is read from the Interaction's own cut sections, never assumed.
+        const auto CutSectionsOf = [&ShowRoot](const int32 SegmentIndex, const ULevelSequence*& OutSequence)
+        {
+            TArray<const UMovieSceneSection*> Sections;
+            OutSequence = nullptr;
+            const int32 CueIndex = ShowRoot->Transport->Segments.IsValidIndex(SegmentIndex)
+                ? ShowRoot->Transport->Segments[SegmentIndex].CueIndex : INDEX_NONE;
+            if (ShowRoot->ShowAsset && ShowRoot->ShowAsset->Cues.IsValidIndex(CueIndex))
+            {
+                OutSequence = ShowRoot->ShowAsset->Cues[CueIndex].Scene.Sequence.LoadSynchronous();
+            }
+            const UMovieScene* Scene = OutSequence ? OutSequence->GetMovieScene() : nullptr;
+            if (const UMovieSceneTrack* Cuts = Scene ? Scene->GetCameraCutTrack() : nullptr)
+            {
+                for (const UMovieSceneSection* Section : Cuts->GetAllSections())
+                {
+                    Sections.Add(Section);
+                }
+                Sections.Sort([](const UMovieSceneSection& A, const UMovieSceneSection& B)
+                    { return A.GetInclusiveStartFrame() < B.GetInclusiveStartFrame(); });
+            }
+            return Sections;
+        };
+        // Index of the Interaction-1 cut section that covers a Master frame, or INDEX_NONE.
+        const auto CutIndexAtMasterFrame = [&ShowRoot, &CutSectionsOf](const FFrameNumber MasterFrame)
+        {
+            const ULevelSequence* Sequence = nullptr;
+            const TArray<const UMovieSceneSection*> Sections = CutSectionsOf(3, Sequence);
+            if (!Sequence || !ShowRoot->ShowAsset)
+            {
+                return int32(INDEX_NONE);
+            }
+            const UMovieScene* Scene = Sequence->GetMovieScene();
+            const FFrameNumber Local = Scene->GetPlaybackRange().GetLowerBoundValue()
+                + FFrameRate::TransformTime(FFrameTime(MasterFrame - ShowRoot->Transport->Segments[3].StartFrame),
+                    ShowRoot->ShowAsset->TickResolution, Scene->GetTickResolution()).FloorToFrame();
+            for (int32 Index = 0; Index < Sections.Num(); ++Index)
+            {
+                if (Sections[Index]->GetRange().Contains(Local))
+                {
+                    return Index;
+                }
+            }
+            return int32(INDEX_NONE);
+        };
+        const ULevelSequence* InteractionOneSequence = nullptr;
+        const int32 InteractionOneCutCount = CutSectionsOf(3, InteractionOneSequence).Num();
+        const bool bInteractionOneSleight = InteractionOneCutCount >= 2;
+        AddInfo(FString::Printf(TEXT("Interaction1Cuts=%d Sleight=%d"), InteractionOneCutCount, bInteractionOneSleight ? 1 : 0));
+        // The sleight camera expected at a frame: cut 0 is the hangar camera, any later cut the mouth camera.
+        const auto IsExpectedSleightCamera = [&CutIndexAtMasterFrame](const AActor* Actor, const FFrameNumber MasterFrame)
+        {
+            const int32 Cut = CutIndexAtMasterFrame(MasterFrame);
+            if (!Actor || Cut == INDEX_NONE
+                || !Actor->ActorHasTag(TEXT("CurtainSleight")) || !Actor->ActorHasTag(TEXT("CurtainSleight.I1")))
+            {
+                return false;
+            }
+            return Actor->GetActorLabel().Contains(Cut == 0 ? TEXT("Hangar") : TEXT("Mouth"));
+        };
+        // Control: an Interaction the sleight has not touched keeps the single stalls cut. Read from data only.
+        for (int32 Index = 4; Index < ShowRoot->Transport->Segments.Num(); ++Index)
+        {
+            const ULevelSequence* Other = nullptr;
+            if (ShowRoot->Transport->Segments[Index].Type == EInfinityCueType::Sequence
+                && ShowRoot->Transport->Segments[Index].CurtainMode == EInfinityCurtainCueMode::PostSceneInterstitial)
+            {
+                const int32 OtherCuts = CutSectionsOf(Index, Other).Num();
+                AddInfo(FString::Printf(TEXT("ControlInteraction=%s Cuts=%d"),
+                    *ShowRoot->Transport->Segments[Index].Label.ToString(), OtherCuts));
+                TestTrue(FString::Printf(TEXT("Control: %s (no sleight) still has at most one cut"),
+                    *ShowRoot->Transport->Segments[Index].Label.ToString()), OtherCuts <= 1);
+                break;
+            }
+        }
