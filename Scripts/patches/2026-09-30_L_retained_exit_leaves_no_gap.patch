+            ExitStart = bRetainedExit ? LastInteriorEnd : FMath::Max(ExitStart, LastInteriorEnd);
         }
         ExitStart = FMath::Min(SceneEndValue - 1, FMath::Max(SceneStartValue, ExitStart));
         ExitCut->SetStartFrame(FFrameNumber(ExitStart));
