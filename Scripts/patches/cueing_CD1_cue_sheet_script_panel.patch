diff --git a/Plugins/InfinityStage/Source/InfinityStageTests/Private/InfinityStageCueSheetTests.cpp b/Plugins/InfinityStage/Source/InfinityStageTests/Private/InfinityStageCueSheetTests.cpp
new file mode 100644
