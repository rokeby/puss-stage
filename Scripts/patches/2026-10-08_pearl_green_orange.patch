+def twin_sync_ops(plan, which="to"):
+    """which = "to" (SYNC) | "from" (REVERT).  Only the planned writes; a forbidden parameter refuses."""
+    ops = []
+    for t in plan["targets"]:
+        for p, w in sorted(t["writes"].items()):
