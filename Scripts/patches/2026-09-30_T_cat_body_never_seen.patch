diff --git a/Plugins/InfinityStage/Source/InfinityStageTests/Private/InfinityStageShadowCatNeverSeenTests.cpp b/Plugins/InfinityStage/Source/InfinityStageTests/Private/InfinityStageShadowCatNeverSeenTests.cpp
