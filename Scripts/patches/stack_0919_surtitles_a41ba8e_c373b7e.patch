diff --git a/Plugins/InfinityStage/Source/InfinityStage/Public/InfinityStageSurtitles.h b/Plugins/InfinityStage/Source/InfinityStage/Public/InfinityStageSurtitles.h
new file mode 100644
index 00000000..8a419a37
--- /dev/null
+++ b/Plugins/InfinityStage/Source/InfinityStage/Public/InfinityStageSurtitles.h
@@ -0,0 +1,218 @@
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Subsystems/WorldSubsystem.h"
+#include "InfinityStageSurtitles.generated.h"
+
+struct FCompositeFont;
+struct FInfinityTransportSegment;
+struct FSlateBrush;
+class AInfinityStageShowRoot;
+class STextBlock;
+class SWidget;
+class UWorld;
+
+/**
+ * Surtitles (Gary, 8 Oct: "text at centre top of screen, visible serifed font,
+ * timecoded"; "should integrate as part of cue system"). First use: what the S5
+ * mountains say to each other in rumbles.
+ *
+ * The text is a sheet, read like the Cue Director's cue sheet: a CSV exported
+ * from Gary's Google Sheet (a "Surtitles" tab), one row per line:
+ *
+ *   Segment, In, Out, Speaker, Text, Notes
+ *   S5,      1:14.0, 1:25.0, West, "We have been here a while.",
+ *
+ * - Segment names the digital segment the line belongs to: S<n> (n-th Scene),
+ *   P<n> (n-th Passage), I<n> (n-th Interaction), counted in show order the same
+ *   way as the Cue Director's use_video = S<n>; or a Show cue label ("Opening").
+ *   Blank carries down from the row above.
+ * - In / Out are times from the START of that segment, so lines move with any
+ *   retime or reorder. Seconds ("74.5"), m:ss.s, h:mm:ss.s, or hh:mm:ss:ff
+ *   (frames at 25 fps). Blank Out holds the line until the next line in the same
+ *   segment, or the segment's end.
+ * - Text may hold line breaks (a quoted multi-line cell).
+ *
+ * Nothing is written to the Show or the level. The file is re-read when it
+ * changes on disk (and on F5 with the cue sheet), so text can be fixed mid-rehearsal.
+ *
+ * What is shown is a pure function of the Master playhead: seeks, reverse, holds
+ * and the Scene video fallbacks (which follow the same playhead) all agree. It is
+ * a viewport overlay in game worlds (PIE and the show), not rendered into MRQ
+ * output, so editing a word never means re-rendering a video.
+ *
+ * Console: InfinityStage.Surtitles 1 show / 0 blackout (key T in the show viewport);
+ * .Path, .Font, .Size, .Top, .BarOpacity, .Fade, .Speakers for rehearsal tuning;
+ * InfinityStage.Surtitles.Dump logs every line at its absolute Master time for proofing.
+ */
+struct INFINITYSTAGE_API FInfinitySurtitleLine
+{
+    /** 1-based row in the CSV, for "see the sheet, row 12". */
+    int32 SourceRow = 0;
+    /** The Cue Book's stable row id (Key column), or empty. Carried through, never invented here. */
+    FString Key;
+    /** As written (after carry-down): "S5", "P2", "I1" or a cue label. */
+    FString Segment;
+    double InSeconds = 0.0;
+    /** Negative: hold until the next line in the segment, or the segment end. */
+    double OutSeconds = -1.0;
+    FString Speaker;
+    FString Text;
+};
+
+struct INFINITYSTAGE_API FInfinitySurtitleScript
+{
+    /** In sheet order. */
+    TArray<FInfinitySurtitleLine> Lines;
+    TArray<FString> Warnings;
+    FString SourcePath;
+
+    /** Finds the header row (a cell "Segment"); columns are found by name. */
+    bool LoadFromCsvText(const FString& Text);
+    bool LoadFromFile(const FString& Path);
+};
+
+/** The line to show this frame (LineIndex INDEX_NONE: nothing). */
+struct INFINITYSTAGE_API FInfinitySurtitleShown
+{
+    int32 LineIndex = INDEX_NONE;
+    int32 SegmentIndex = INDEX_NONE;
+    float Opacity = 0.0f;
+};
+
+namespace InfinityStageSurtitles
+{
+/** Seconds, m:ss.s, h:mm:ss.s, or hh:mm:ss:ff (four fields: last is frames at Fps). */
+INFINITYSTAGE_API bool ParseTime(const FString& Text, double Fps, double& OutSeconds);
+
+/** "m:ss.ss". */
+INFINITYSTAGE_API FString FormatTime(double Seconds);
+
+/** "S3" / "P2" / "I1" for a segment: its kind letter and 1-based ordinal among that kind. */
+INFINITYSTAGE_API FString SegmentCode(const TArray<FInfinityTransportSegment>& Segments, int32 SegmentIndex);
+
+/** True when a line's Segment names this segment (code or cue label, case-insensitive). */
+INFINITYSTAGE_API bool LineMatchesSegment(const FInfinitySurtitleLine& Line, const TArray<FInfinityTransportSegment>& Segments, int32 SegmentIndex);
+
+/** First segment a key names, or INDEX_NONE. */
+INFINITYSTAGE_API int32 ResolveSegment(const FString& Key, const TArray<FInfinityTransportSegment>& Segments);
+
+/** The segment's length in seconds. */
+INFINITYSTAGE_API double SegmentSeconds(const FInfinityTransportSegment& Segment, double TicksPerSecond);
+
+/** A line's effective out time in its segment (blank Out resolved), in segment seconds. */
+INFINITYSTAGE_API double EffectiveOut(const FInfinitySurtitleScript& Script, int32 LineIndex, const TArray<FInfinityTransportSegment>& Segments, int32 SegmentIndex, double TicksPerSecond);
+
+/**
+ * What to show at a Master frame. Of the lines in the segment under the playhead
+ * that have started, the latest-starting one wins while it is before its out.
+ * Opacity ramps over FadeSeconds at both ends (0: hard cuts).
+ */
+INFINITYSTAGE_API FInfinitySurtitleShown Evaluate(
+    const FInfinitySurtitleScript& Script,
+    const TArray<FInfinityTransportSegment>& Segments,
+    int64 MasterFrame,
+    double TicksPerSecond,
+    double FadeSeconds);
+
+/**
+ * Rewrites one line's In or Out in the raw sheet text, touching that one cell only: every
+ * other cell, column (Key, Notes, unknown ones), row and the line endings are kept.
+ * Refuses (false, OutError) when the row no longer matches Line (Key or In changed on disk),
+ * when the sheet has no Out column, or when the result would be skipped by the parser
+ * (Out <= In).
+ */
+INFINITYSTAGE_API bool SetLineTime(FString& InOutCsvText, const FInfinitySurtitleLine& Line, bool bOut, double Seconds, FString& OutError);
+
+/** RFC-4180: quotes a cell only when it holds a comma, quote, CR or LF. */
+INFINITYSTAGE_API FString SerializeCsv(const TArray<TArray<FString>>& Table, const TCHAR* LineEnd);
+
+/** Where a step lands on a line: just past its fade-in, so a paused frame shows it. */
+INFINITYSTAGE_API double LandingSeconds(const FInfinitySurtitleLine& Line, double OutSeconds, double FadeSeconds);
+
+/**
+ * The line a Previous (-1) / Next (+1) step goes to from a Master frame, by landing time
+ * across the whole show; clear rows (no text) and unresolved segments are skipped.
+ * INDEX_NONE at either end. OutLandingFrame is the absolute Master frame to scrub to.
+ */
+INFINITYSTAGE_API int32 FindStepTarget(
+    const FInfinitySurtitleScript& Script,
+    const TArray<FInfinityTransportSegment>& Segments,
+    int64 MasterFrame,
+    double TicksPerSecond,
+    double FadeSeconds,
+    int32 Delta,
+    int64& OutLandingFrame);
+
+/** Content/InfinityStage/CueSheet/Puss_Surtitles.csv (console InfinityStage.Surtitles.Path overrides). */
+INFINITYSTAGE_API FString ResolvePath();
+
+/** Operator blackout: flips InfinityStage.Surtitles. */
+INFINITYSTAGE_API void ToggleBlackout();
+}
+
+/** Loads the surtitle sheet and draws the current line over the show, per game world. */
+UCLASS()
+class INFINITYSTAGE_API UInfinityStageSurtitleSubsystem final : public UTickableWorldSubsystem
+{
+    GENERATED_BODY()
+
+public:
+    virtual bool DoesSupportWorldType(const EWorldType::Type WorldType) const override;
+    virtual void Initialize(FSubsystemCollectionBase& Collection) override;
+    virtual void Deinitialize() override;
+    virtual void Tick(float DeltaTime) override;
+    virtual TStatId GetStatId() const override { RETURN_QUICK_DECLARE_CYCLE_STAT(UInfinityStageSurtitleSubsystem, STATGROUP_Tickables); }
+
+    /** Re-reads the sheet. */
+    bool Reload();
+
+    /** Logs every line with its absolute Master time (INFINITY_SURTITLE rows) for proofing. */
+    void Dump();
+
+    const FInfinitySurtitleScript& GetScript() const { return Script; }
+
+    // Rehearsal controls, for the Cue Director interface (Gary, 9 Oct: "part of the cue
+    // director interface to be adjustable and rehearsable"). Each returns false with a
+    // reason in GetLastMessage(); none of them writes the Show or the level.
+
+    /** Scrubs (ScrubToMasterFrame: pauses) to the next (+1) / previous (-1) line and selects it. */
+    bool StepLine(int32 Delta);
+
+    /** Sets the selected line's In (or Out) to the playhead, in the sheet file. */
+    bool StampAtPlayhead(bool bOut);
+
+    /** Moves the selected line's In (or Out) by DeltaSeconds, in the sheet file. A blank Out becomes explicit. */
+    bool Nudge(bool bOut, double DeltaSeconds);
+
+    /** The selected line: the last one stepped to, else the one on screen. INDEX_NONE: none. */
+    int32 GetSelectedLine() const;
+
+    /** "S5 row 12 [T3k] 1:14.00-1:25.00 West: We have been here..." or "no surtitle selected". */
+    FString DescribeSelected() const;
+
+    const FString& GetLastMessage() const { return LastMessage; }
+
+private:
+    bool Fail(const FString& Message);
+    bool WriteLineTime(int32 LineIndex, bool bOut, double Seconds);
+    void ApplyStyle();
+    AInfinityStageShowRoot* FindRoot();
+
+    FInfinitySurtitleScript Script;
+    FDateTime LoadedStamp;
+    double NextStampCheck = 0.0;
+
+    TWeakObjectPtr<AInfinityStageShowRoot> Root;
+    TSharedPtr<SWidget> Overlay;
+    TSharedPtr<SWidget> Bar;
+    TSharedPtr<STextBlock> TextBlock;
+    TSharedPtr<STextBlock> SpeakerBlock;
+    TSharedPtr<const FCompositeFont> Font;
+    TSharedPtr<FSlateBrush> BarBrush;
+    FString StyleKey;
+    int32 ShownLine = INDEX_NONE;
+    int32 SelectedLine = INDEX_NONE;
+    FString LastMessage;
+    bool bOverlayAdded = false;
+};
diff --git a/Plugins/InfinityStage/Source/InfinityStageTests/Private/InfinityStageSurtitleTests.cpp b/Plugins/InfinityStage/Source/InfinityStageTests/Private/InfinityStageSurtitleTests.cpp
new file mode 100644
index 00000000..3641c956
--- /dev/null
+++ b/Plugins/InfinityStage/Source/InfinityStageTests/Private/InfinityStageSurtitleTests.cpp
@@ -0,0 +1,249 @@
+#include "InfinityStageSurtitles.h"
+#include "InfinityStageTransportController.h"
+#include "Misc/AutomationTest.h"
+
+#if WITH_DEV_AUTOMATION_TESTS
+
+namespace
+{
+constexpr double SurtitleTicks = 24000.0;
+
+FInfinityTransportSegment MakeSurtitleSegment(const EInfinityCueType Type, const TCHAR* Label, const double StartSeconds, const double EndSeconds)
+{
+    FInfinityTransportSegment Segment;
+    Segment.Type = Type;
+    Segment.Label = FText::FromString(Label);
+    Segment.StartFrame = FFrameNumber(int32(StartSeconds * SurtitleTicks));
+    Segment.EndFrame = FFrameNumber(int32(EndSeconds * SurtitleTicks));
+    return Segment;
+}
+
+/** Passage 1 [0,100), Scene 1 [100,200), Passage 2 [200,300), Scene 2 "Mountains" [300,452.341). */
+TArray<FInfinityTransportSegment> MakeSurtitleShow()
+{
+    return {
+        MakeSurtitleSegment(EInfinityCueType::WingPair, TEXT("Passage 1"), 0.0, 100.0),
+        MakeSurtitleSegment(EInfinityCueType::Scene, TEXT("S1 Animals"), 100.0, 200.0),
+        MakeSurtitleSegment(EInfinityCueType::WingPair, TEXT("Passage 2"), 200.0, 300.0),
+        MakeSurtitleSegment(EInfinityCueType::Scene, TEXT("Mountains"), 300.0, 452.341),
+    };
+}
+
+int64 SurtitleAt(const double MasterSeconds)
+{
+    return int64(FMath::RoundToDouble(MasterSeconds * SurtitleTicks));
+}
+
+// The Google Sheet export shape: a title row, the header, carry-down segments, a quoted
+// multi-line cell, a clear row (time, no text), a bad time, and a Passage line by label.
+const TCHAR* SurtitleSheetCsv =
+    TEXT("Surtitles,,,,,\n")
+    TEXT("Segment,In,Out,Speaker,Text,Notes\n")
+    TEXT("S2,1:14,1:25,West,\"We have been here\na while.\",slow\n")
+    TEXT(",1:40,,East,Yes.,\n")
+    TEXT(",2:01,,,,clear\n")
+    TEXT(",2:10,2:05,West,Out before In,\n")
+    TEXT(",soon,,West,Bad time,\n")
+    TEXT("Passage 2,00:00:10:12,,,On the road,\n")
+    TEXT(",,,,No time at all,\n");
+}
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(
+    FInfinityStageSurtitleTimeTest,
+    "InfinityStage.Surtitles.ParseTime",
+    EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)
+
+bool FInfinityStageSurtitleTimeTest::RunTest(const FString& Parameters)
+{
+    double Seconds = -1.0;
+    TestTrue(TEXT("Plain seconds"), InfinityStageSurtitles::ParseTime(TEXT("74.5"), 25.0, Seconds));
+    TestEqual(TEXT("...74.5"), Seconds, 74.5);
+    TestTrue(TEXT("m:ss.s"), InfinityStageSurtitles::ParseTime(TEXT(" 1:14.5 "), 25.0, Seconds));
+    TestEqual(TEXT("...74.5"), Seconds, 74.5);
+    TestTrue(TEXT("h:mm:ss"), InfinityStageSurtitles::ParseTime(TEXT("1:00:01"), 25.0, Seconds));
+    TestEqual(TEXT("...3601"), Seconds, 3601.0);
+    TestTrue(TEXT("hh:mm:ss:ff at 25 fps"), InfinityStageSurtitles::ParseTime(TEXT("00:02:01:05"), 25.0, Seconds));
+    TestEqual(TEXT("...121.2"), Seconds, 121.2, 1e-9);
+    TestFalse(TEXT("Control: frame 25 is out of range at 25 fps"), InfinityStageSurtitles::ParseTime(TEXT("00:00:01:25"), 25.0, Seconds));
+    TestFalse(TEXT("Control: words are not a time"), InfinityStageSurtitles::ParseTime(TEXT("soon"), 25.0, Seconds));
+    TestFalse(TEXT("Control: negative is not a time"), InfinityStageSurtitles::ParseTime(TEXT("-3"), 25.0, Seconds));
+    TestFalse(TEXT("Control: empty is not a time"), InfinityStageSurtitles::ParseTime(TEXT(""), 25.0, Seconds));
+    TestEqual(TEXT("FormatTime"), InfinityStageSurtitles::FormatTime(74.5), FString(TEXT("1:14.50")));
+    return true;
+}
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(
+    FInfinityStageSurtitleSheetTest,
+    "InfinityStage.Surtitles.SheetLoads",
+    EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)
+
+bool FInfinityStageSurtitleSheetTest::RunTest(const FString& Parameters)
+{
+    FInfinitySurtitleScript Script;
+    TestTrue(TEXT("The sheet loads"), Script.LoadFromCsvText(SurtitleSheetCsv));
+    // Kept: 1:14, 1:40, 2:01 (clear), Passage 2. Dropped with a warning: Out<In, bad time, no time.
+    TestEqual(TEXT("Four lines kept"), Script.Lines.Num(), 4);
+    TestEqual(TEXT("Three warnings"), Script.Warnings.Num(), 3);
+    if (Script.Lines.Num() == 4)
+    {
+        TestEqual(TEXT("Row numbers are the sheet's, 1-based"), Script.Lines[0].SourceRow, 3);
+        TestEqual(TEXT("Multi-line cell kept"), Script.Lines[0].Text, FString(TEXT("We have been here\na while.")));
+        TestEqual(TEXT("Explicit Out"), Script.Lines[0].OutSeconds, 85.0);
+        TestEqual(TEXT("Segment carries down"), Script.Lines[1].Segment, FString(TEXT("S2")));
+        TestTrue(TEXT("Blank Out holds"), Script.Lines[1].OutSeconds < 0.0);
+        TestTrue(TEXT("A clear row has no text"), Script.Lines[2].Text.IsEmpty());
+        TestEqual(TEXT("Label segment"), Script.Lines[3].Segment, FString(TEXT("Passage 2")));
+        TestEqual(TEXT("SMPTE In"), Script.Lines[3].InSeconds, 10.48, 1e-9);
+    }
+
+    FInfinitySurtitleScript NoHeader;
+    TestFalse(TEXT("Control: a sheet with no Segment header fails"), NoHeader.LoadFromCsvText(TEXT("a,b\n1,2\n")));
+    return true;
+}
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(
+    FInfinityStageSurtitleSegmentTest,
+    "InfinityStage.Surtitles.SegmentCodesMatchCueDirector",
+    EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)
+
+bool FInfinityStageSurtitleSegmentTest::RunTest(const FString& Parameters)
+{
+    const TArray<FInfinityTransportSegment> Show = MakeSurtitleShow();
+    TestEqual(TEXT("P1"), InfinityStageSurtitles::SegmentCode(Show, 0), FString(TEXT("P1")));
+    TestEqual(TEXT("S1 counts Scenes only"), InfinityStageSurtitles::SegmentCode(Show, 1), FString(TEXT("S1")));
+    TestEqual(TEXT("P2"), InfinityStageSurtitles::SegmentCode(Show, 2), FString(TEXT("P2")));
+    TestEqual(TEXT("S2"), InfinityStageSurtitles::SegmentCode(Show, 3), FString(TEXT("S2")));
+    TestEqual(TEXT("Code, any case"), InfinityStageSurtitles::ResolveSegment(TEXT("s2"), Show), 3);
+    TestEqual(TEXT("Cue label, any case"), InfinityStageSurtitles::ResolveSegment(TEXT(" mountains "), Show), 3);
+    TestEqual(TEXT("Control: S3 does not exist"), InfinityStageSurtitles::ResolveSegment(TEXT("S3"), Show), INDEX_NONE);
+    return true;
+}
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(
+    FInfinityStageSurtitleEvaluateTest,
+    "InfinityStage.Surtitles.EvaluateFollowsPlayhead",
+    EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)
+
+bool FInfinityStageSurtitleEvaluateTest::RunTest(const FString& Parameters)
+{
+    const TArray<FInfinityTransportSegment> Show = MakeSurtitleShow();
+    FInfinitySurtitleScript Script;
+    Script.LoadFromCsvText(SurtitleSheetCsv);
+
+    auto LineAt = [&](const double MasterSeconds, const double Fade = 0.0)
+    {
+        return InfinityStageSurtitles::Evaluate(Script, Show, SurtitleAt(MasterSeconds), SurtitleTicks, Fade);
+    };
+
+    // Mountains (S2) starts at Master 300 s.
+    TestEqual(TEXT("Control: nothing before the first line"), LineAt(300.0 + 73.9).LineIndex, INDEX_NONE);
+    TestEqual(TEXT("First line at its In"), LineAt(300.0 + 74.0).LineIndex, 0);
+    TestEqual(TEXT("First line ends at its explicit Out"), LineAt(300.0 + 85.0).LineIndex, INDEX_NONE);
+    TestEqual(TEXT("Second line held (blank Out)"), LineAt(300.0 + 120.0).LineIndex, 1);
+    TestEqual(TEXT("A clear row ends the held line"), LineAt(300.0 + 121.0).LineIndex, 2);
+    TestTrue(TEXT("...and shows no text"), Script.Lines[LineAt(300.0 + 121.0).LineIndex].Text.IsEmpty());
+    TestEqual(TEXT("Passage line by label, held to the segment end"), LineAt(200.0 + 99.9).LineIndex, 3);
+    TestEqual(TEXT("Control: the same offset in another segment shows nothing"), LineAt(100.0 + 74.0).LineIndex, INDEX_NONE);
+    TestEqual(TEXT("Control: past the show end shows nothing"), LineAt(500.0).LineIndex, INDEX_NONE);
+
+    // Pure function of the playhead: a seek back lands on the same answer.
+    const FInfinitySurtitleShown Forward = LineAt(300.0 + 80.0, 0.3);
+    LineAt(300.0 + 140.0, 0.3);
+    const FInfinitySurtitleShown Back = LineAt(300.0 + 80.0, 0.3);
+    TestEqual(TEXT("Seek back: same line"), Back.LineIndex, Forward.LineIndex);
+    TestEqual(TEXT("Seek back: same opacity"), Back.Opacity, Forward.Opacity);
+
+    TestEqual(TEXT("Fade: half in at 0.15 s"), LineAt(300.0 + 74.15, 0.3).Opacity, 0.5f, 1e-3f);
+    TestEqual(TEXT("Fade: full mid-line"), LineAt(300.0 + 80.0, 0.3).Opacity, 1.0f);
+    TestEqual(TEXT("Fade: half out 0.15 s before Out"), LineAt(300.0 + 84.85, 0.3).Opacity, 0.5f, 1e-3f);
+
+    // A retime moves the Scene; the line moves with it.
+    TArray<FInfinityTransportSegment> Retimed = Show;
+    Retimed[3].StartFrame = FFrameNumber(int32(310.0 * SurtitleTicks));
+    Retimed[3].EndFrame = FFrameNumber(int32(462.341 * SurtitleTicks));
+    TestEqual(TEXT("Retime: line follows its segment"),
+        InfinityStageSurtitles::Evaluate(Script, Retimed, SurtitleAt(310.0 + 74.0), SurtitleTicks, 0.0).LineIndex, 0);
+    TestEqual(TEXT("Control: the old Master time no longer shows it"),
+        InfinityStageSurtitles::Evaluate(Script, Retimed, SurtitleAt(300.0 + 74.0), SurtitleTicks, 0.0).LineIndex, INDEX_NONE);
+    return true;
+}
