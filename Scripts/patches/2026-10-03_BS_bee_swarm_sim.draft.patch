@@ -0,0 +1,86 @@
+#pragma once
+
+#include "CoreMinimal.h"
+
+/**
+ * Offline, deterministic behaviour parameters for the S6 bee/firefly swarm.
+ * Niagara owns rendering only; this simulation owns positions and velocities.
+ */
+struct INFINITYSTAGE_API FInfinityStageBeeSwarmParameters
+{
+    int32 BeeCount = 200;
+    uint32 Seed = 0xBEE62026u;
+    float FixedStepSeconds = 1.0f / 120.0f;
+
+    FVector BoundsExtentCm = FVector(600.0, 450.0, 300.0);
+    float TargetWanderSpeedCmPerSecond = 180.0f;
+    FVector2D TargetJumpIntervalSeconds = FVector2D(1.5, 4.5);
+    FVector2D OrbitRadiusRangeCm = FVector2D(35.0, 180.0);
+    float LargeNoiseScalePerCm = 0.003f;
+    float SmallNoiseScalePerCm = 0.014f;
+    float LargeNoiseAccelerationCmPerSecondSquared = 220.0f;
+    float SmallNoiseAccelerationCmPerSecondSquared = 90.0f;
+    float DartRatePerSecond = 0.12f;
+    float DartStrengthCmPerSecond = 420.0f;
+    float DragPerSecond = 1.6f;
+    float MaxSpeedCmPerSecond = 900.0f;
+    float CameraAttractWeight = 0.08f;
+    float CameraRepulsionRadiusCm = 25.0f;
+    float FlyByRatePerSecond = 0.35f;
+};
+
+struct INFINITYSTAGE_API FInfinityStageBeeKinematics
+{
+    FVector Position = FVector::ZeroVector;
+    FVector Velocity = FVector::ZeroVector;
+};
+
+/** Fixed-step swarm core. It has no UObject or Niagara dependency and is unit-testable offline. */
+class INFINITYSTAGE_API FInfinityStageBeeSwarmSimulation
+{
+public:
+    void Reset(
+        const FInfinityStageBeeSwarmParameters& InParameters,
+        const FVector& InSwarmOrigin,
+        const FVector& InCameraPosition);
+
+    /** Advances by real time; internally integrates at Parameters.FixedStepSeconds. */
+    void Advance(float DeltaSeconds, const FVector& CameraPosition);
+
+    TConstArrayView<FInfinityStageBeeKinematics> GetBees() const { return Bees; }
+    const FVector& GetTargetPosition() const { return TargetPosition; }
+    double GetSimulationSeconds() const { return SimulationSeconds; }
+
+private:
+    struct FBeeRuntime
+    {
+        FVector OrbitAxis = FVector::UpVector;
+        float OrbitRadiusCm = 100.0f;
+        double NextDartSeconds = 0.0;
+        uint32 RandomState = 1u;
+    };
+
+    void StepFixed(float StepSeconds, const FVector& CameraPosition);
+    void UpdateTarget(float StepSeconds);
+    void InjectFlyBy(const FVector& CameraPosition);
+    void ConstrainToBounds(FVector& Position, FVector& Velocity, float ExtentScale) const;
+
+    static uint32 NextRandom(uint32& State);
+    static float Random01(uint32& State);
+    static float RandomRange(uint32& State, float Minimum, float Maximum);
+    static FVector RandomUnitVector(uint32& State);
+    static FVector CurlNoise(const FVector& Position, double TimeSeconds, float Scale, float TimeScale);
+    static double SchedulePoisson(double NowSeconds, float RatePerSecond, uint32& RandomState);
+
+    FInfinityStageBeeSwarmParameters Parameters;
+    FVector SwarmOrigin = FVector::ZeroVector;
+    FVector TargetPosition = FVector::ZeroVector;
+    FVector TargetVelocity = FVector::ZeroVector;
+    TArray<FInfinityStageBeeKinematics> Bees;
+    TArray<FBeeRuntime> BeeRuntime;
+    uint32 TargetRandomState = 1u;
+    double SimulationSeconds = 0.0;
+    double AccumulatorSeconds = 0.0;
+    double NextTargetJumpSeconds = 0.0;
+    double NextFlyBySeconds = 0.0;
+};
diff --git a/Plugins/InfinityStage/Source/InfinityStageTests/Private/InfinityStageBeeSwarmTests.cpp b/Plugins/InfinityStage/Source/InfinityStageTests/Private/InfinityStageBeeSwarmTests.cpp
new file mode 100644
index 0000000..0097129
--- /dev/null
+++ b/Plugins/InfinityStage/Source/InfinityStageTests/Private/InfinityStageBeeSwarmTests.cpp
@@ -0,0 +1,101 @@
+#include "InfinityStageBeeSwarmSimulation.h"
+
+#include "Misc/AutomationTest.h"
+
+#if WITH_DEV_AUTOMATION_TESTS
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(
+    FInfinityStageBeeSwarmBehaviourTest,
+    "InfinityStage.Effects.BeeSwarm.BehaviourIsBoundedRepelledAndNonRepeating",
+    EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)
+
+bool FInfinityStageBeeSwarmBehaviourTest::RunTest(const FString& Parameters)
+{
+    FInfinityStageBeeSwarmParameters SwarmParameters;
+    SwarmParameters.BeeCount = 48;
+    SwarmParameters.Seed = 0xBEE62026u;
+    SwarmParameters.BoundsExtentCm = FVector(600.0, 450.0, 300.0);
+
+    const FVector Origin = FVector::ZeroVector;
+    const FVector Camera = FVector::ZeroVector;
+    FInfinityStageBeeSwarmSimulation Simulation;
+    Simulation.Reset(SwarmParameters, Origin, Camera);
+
+    constexpr int32 FramesPerSecond = 60;
+    constexpr int32 DurationSeconds = 60;
+    constexpr int32 SampleEveryFrames = 6;
+    TArray<FVector> BeeZeroPath;
+    BeeZeroPath.Reserve(DurationSeconds * FramesPerSecond / SampleEveryFrames);
+
+    bool bAllWithinBounds = true;
+    bool bRepulsionNeverViolated = true;
+    double MaximumNormalisedExtent = 0.0;
+    double MinimumCameraDistance = TNumericLimits<double>::Max();
+
+    for (int32 Frame = 0; Frame < DurationSeconds * FramesPerSecond; ++Frame)
+    {
+        Simulation.Advance(1.0f / FramesPerSecond, Camera);
+        const TConstArrayView<FInfinityStageBeeKinematics> Bees = Simulation.GetBees();
+        for (const FInfinityStageBeeKinematics& Bee : Bees)
+        {
+            const FVector Relative = Bee.Position - Origin;
+            const double NormalisedExtent = FMath::Max3(
+                FMath::Abs(Relative.X) / SwarmParameters.BoundsExtentCm.X,
+                FMath::Abs(Relative.Y) / SwarmParameters.BoundsExtentCm.Y,
+                FMath::Abs(Relative.Z) / SwarmParameters.BoundsExtentCm.Z);
+            MaximumNormalisedExtent = FMath::Max(MaximumNormalisedExtent, NormalisedExtent);
+            bAllWithinBounds &= NormalisedExtent <= 1.0 + UE_DOUBLE_KINDA_SMALL_NUMBER;
+
+            const double CameraDistance = FVector::Distance(Bee.Position, Camera);
+            MinimumCameraDistance = FMath::Min(MinimumCameraDistance, CameraDistance);
+            bRepulsionNeverViolated &= CameraDistance + 0.01
+                >= SwarmParameters.CameraRepulsionRadiusCm;
+        }
+        if (Frame % SampleEveryFrames == 0)
+        {
+            BeeZeroPath.Add(Bees[0].Position);
+        }
+    }
+
+    TestTrue(
+        *FString::Printf(TEXT("Every bee stays inside the configured bounds (max normalized extent %.6f)"), MaximumNormalisedExtent),
+        bAllWithinBounds);
+    TestTrue(
+        *FString::Printf(TEXT("The camera repulsion bubble is never violated (minimum %.3f cm)"), MinimumCameraDistance),
+        bRepulsionNeverViolated);
+
+    // Ten-second-lag normalized autocorrelation over a 60 s, 10 Hz path. A
+    // repeating orbit tends toward 1.0; the acceptance threshold is fixed here
+    // before rendered tuning so a prettier loop cannot quietly redefine it.
+    constexpr int32 LagSamples = 100;
+    constexpr double MaximumAbsoluteAutocorrelation = 0.85;
+    FVector Mean = FVector::ZeroVector;
+    for (const FVector& Sample : BeeZeroPath)
+    {
+        Mean += Sample;
+    }
+    Mean /= BeeZeroPath.Num();
+
+    double Numerator = 0.0;
+    double FirstEnergy = 0.0;
+    double SecondEnergy = 0.0;
+    for (int32 Index = 0; Index + LagSamples < BeeZeroPath.Num(); ++Index)
+    {
+        const FVector First = BeeZeroPath[Index] - Mean;
+        const FVector Second = BeeZeroPath[Index + LagSamples] - Mean;
+        Numerator += FVector::DotProduct(First, Second);
+        FirstEnergy += First.SizeSquared();
+        SecondEnergy += Second.SizeSquared();
+    }
+    const double Autocorrelation = Numerator
+        / FMath::Sqrt(FMath::Max(UE_DOUBLE_SMALL_NUMBER, FirstEnergy * SecondEnergy));
+    TestTrue(
+        *FString::Printf(
+            TEXT("A bee path has |10 s autocorrelation| below %.2f over 60 s (actual %.6f)"),
+            MaximumAbsoluteAutocorrelation,
+            FMath::Abs(Autocorrelation)),
+        FMath::Abs(Autocorrelation) < MaximumAbsoluteAutocorrelation);
+    return true;
+}
+
+#endif
