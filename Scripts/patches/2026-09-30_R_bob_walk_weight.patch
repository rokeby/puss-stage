+double AInfinityStageCameraRig::StepGaitWalkWeight(
+    double& InOutWeight,
+    bool& bInOutPrimed,
+    const double SpeedCmPerSecond,
+    const double ReferenceSpeedCmPerSecond,
+    const double DeltaSeconds,
+    const double FadeSeconds,
+    const double MaxGapSeconds)
+{
+    if (!bInOutPrimed || DeltaSeconds < 0.0 || DeltaSeconds > MaxGapSeconds)
+    {
+        InOutWeight = 0.0;
+        bInOutPrimed = true;
+        return 0.0;
+    }
+    const double TargetWeight = FMath::Clamp(
+        SpeedCmPerSecond / FMath::Max(1.0, ReferenceSpeedCmPerSecond),
+        0.0,
+        1.0);
+    const double Alpha = FadeSeconds > UE_DOUBLE_SMALL_NUMBER
+        ? 1.0 - FMath::Exp(-DeltaSeconds / FadeSeconds)
+        : 1.0;
+    InOutWeight += (TargetWeight - InOutWeight) * Alpha;
+    return InOutWeight;
+}
