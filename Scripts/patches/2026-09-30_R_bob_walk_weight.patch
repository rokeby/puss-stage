diff --git a/Plugins/InfinityStage/Source/InfinityStageTests/Private/InfinityStageGaitWalkWeightTests.cpp b/Plugins/InfinityStage/Source/InfinityStageTests/Private/InfinityStageGaitWalkWeightTests.cpp
