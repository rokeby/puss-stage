index 0000000..de3018b
--- /dev/null
+++ b/Plugins/InfinityStage/Source/InfinityStageTests/Private/InfinityStageGaitWalkWeightTests.cpp
@@ -0,0 +1,90 @@
+#include "InfinityStageCameraRig.h"
+#include "Misc/AutomationTest.h"
+
+#if WITH_DEV_AUTOMATION_TESTS
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(
+    FInfinityStageGaitWalkWeightTest,
+    "InfinityStage.ShadowCat.BobFadesWithTheWalk",
+    EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)
+
+bool FInfinityStageGaitWalkWeightTest::RunTest(const FString& Parameters)
+{
+    constexpr double Dt = 1.0 / 30.0;
+    constexpr double ReferenceSpeed = 250.0;
+    constexpr double FadeSeconds = 0.5;
+
+    double Weight = 1.0;
+    bool bPrimed = false;
+    TestEqual(TEXT("The first sample re-primes the walk weight to zero"),
+        AInfinityStageCameraRig::StepGaitWalkWeight(
+            Weight, bPrimed, ReferenceSpeed, ReferenceSpeed, Dt, FadeSeconds),
+        0.0);
+
+    double PreviousWeight = Weight;
+    for (int32 Step = 1; Step <= 45; ++Step)
+    {
+        Weight = AInfinityStageCameraRig::StepGaitWalkWeight(
+            Weight, bPrimed, ReferenceSpeed, ReferenceSpeed, Dt, FadeSeconds);
+        TestTrue(TEXT("At reference speed the walk weight rises monotonically"), Weight >= PreviousWeight);
+        PreviousWeight = Weight;
+        if (Step == 6)
+        {
+            TestTrue(TEXT("The fade is still below half weight at 0.2 seconds"), Weight < 0.5);
+        }
+    }
+    TestTrue(TEXT("The fade exceeds 0.95 by 1.5 seconds"), Weight > 0.95);
+
+    Weight = 1.0;
+    bPrimed = false;
+    for (int32 Step = 0; Step <= 30; ++Step)
+    {
+        const double Speed = ReferenceSpeed * (1.0 - static_cast<double>(Step) / 30.0);
+        Weight = AInfinityStageCameraRig::StepGaitWalkWeight(
+            Weight, bPrimed, Speed, ReferenceSpeed, Step == 0 ? 0.0 : Dt, FadeSeconds);
+    }
+    for (int32 Step = 0; Step < 30; ++Step)
+    {
+        Weight = AInfinityStageCameraRig::StepGaitWalkWeight(
+            Weight, bPrimed, 0.0, ReferenceSpeed, Dt, FadeSeconds);
+    }
+    TestTrue(TEXT("One second after stopping the walk weight is below 0.05"), Weight < 0.05);
+
+    Weight = 0.0;
+    bPrimed = false;
+    AInfinityStageCameraRig::StepGaitWalkWeight(
+        Weight, bPrimed, 125.0, ReferenceSpeed, 0.0, FadeSeconds);
+    for (int32 Step = 0; Step < 150; ++Step)
+    {
+        Weight = AInfinityStageCameraRig::StepGaitWalkWeight(
+            Weight, bPrimed, 125.0, ReferenceSpeed, Dt, FadeSeconds);
+    }
+    TestEqual(TEXT("Half reference speed settles at half walk weight"), Weight, 0.5, 0.02);
+
+    Weight = 0.75;
+    bPrimed = true;
+    TestEqual(TEXT("A 2 second gap re-primes the walk weight to zero"),
+        AInfinityStageCameraRig::StepGaitWalkWeight(
+            Weight, bPrimed, ReferenceSpeed, ReferenceSpeed, 2.0, FadeSeconds),
+        0.0);
+    Weight = 0.75;
+    TestEqual(TEXT("A negative time step re-primes the walk weight to zero"),
+        AInfinityStageCameraRig::StepGaitWalkWeight(
+            Weight, bPrimed, ReferenceSpeed, ReferenceSpeed, -Dt, FadeSeconds),
+        0.0);
+    Weight = 0.25;
+    const double BeforeZeroStep = Weight;
+    AInfinityStageCameraRig::StepGaitWalkWeight(
+        Weight, bPrimed, ReferenceSpeed, ReferenceSpeed, 0.0, FadeSeconds);
+    TestEqual(TEXT("A zero time step leaves the walk weight unchanged"), Weight, BeforeZeroStep);
+
+    constexpr double CreepingSpeed = 1.0;
+    const bool bOldBooleanIsMoving = CreepingSpeed > KINDA_SMALL_NUMBER;
+    const double CreepingTarget = FMath::Clamp(CreepingSpeed / ReferenceSpeed, 0.0, 1.0);
+    TestTrue(TEXT("At 1 cm/s the old boolean is true while the weighted target is only 0.004"),
+        bOldBooleanIsMoving && FMath::IsNearlyEqual(CreepingTarget, 0.004));
+
+    return true;
+}
+
+#endif
