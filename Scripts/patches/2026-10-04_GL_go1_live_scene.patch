         // curtain while the dog is being walked (A.5, Gary 2026-09-26). Only the
@@ -286,3 +312,10 @@ EInfinityCameraOwner AInfinityStageShowRoot::GetCurrentCameraOwner() const
 {
     return GetCameraOwnerAtFrame(Transport ? Transport->GetCurrentMasterFrame() : FFrameNumber(0));
 }
+
+EInfinityCameraOwner AInfinityStageShowRoot::ResolveCurrentCameraOwner(bool& bOutGo1LiveScene) const
+{
+    return ResolveCameraOwnerAtFrame(
+        Transport ? Transport->GetCurrentMasterFrame() : FFrameNumber(0),
+        bOutGo1LiveScene);
+}
diff --git a/Plugins/InfinityStage/Source/InfinityStage/Public/InfinityStageShowRoot.h b/Plugins/InfinityStage/Source/InfinityStage/Public/InfinityStageShowRoot.h
