@@ -65,6 +65,24 @@ public:
     UFUNCTION(BlueprintPure, Category = "Infinity Stage|Camera")
     EInfinityCameraOwner GetCurrentCameraOwner() const;
 
+    /**
+     * True when the segment containing MasterFrame is a Scene authored with GO1
+     * Drives Camera and the dog actually owns the camera there (so false while
+     * Timeline is forced). Inside such a Scene the dog's look carries across the
+     * Scene's own cuts instead of resetting.
+     */
+    UFUNCTION(BlueprintPure, Category = "Infinity Stage|Camera")
+    bool IsGo1LiveSceneAtFrame(FFrameNumber MasterFrame) const;
+
+    /**
+     * GetCameraOwnerAtFrame and IsGo1LiveSceneAtFrame in one pass, so a caller
+     * that needs both every tick compiles the Show once, not twice.
+     */
+    EInfinityCameraOwner ResolveCameraOwnerAtFrame(FFrameNumber MasterFrame, bool& bOutGo1LiveScene) const;
