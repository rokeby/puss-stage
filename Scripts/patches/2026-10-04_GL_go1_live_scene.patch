+}
+
+EInfinityCameraOwner AInfinityStageShowRoot::ResolveCameraOwnerAtFrame(
+    const FFrameNumber MasterFrame,
+    bool& bOutGo1LiveScene) const
+{
+    bOutGo1LiveScene = false;
     // Forcing Timeline is the dog-failure drill (F.4): it wins everywhere.
     if (bOverrideCameraOwner && CameraOwnerOverride == EInfinityCameraOwner::Timeline)
     {
@@ -267,7 +283,17 @@ EInfinityCameraOwner AInfinityStageShowRoot::GetCameraOwnerAtFrame(const FFrameN
         const FInfinityShowCue* Cue = ShowAsset->Cues.FindByPredicate(
             [&Segment](const FInfinityShowCue& Candidate)
             { return Candidate.CueGuid == Segment.SegmentGuid; });
-        const EInfinityCameraOwner Authored = Cue ? Cue->Scene.CameraOwner : EInfinityCameraOwner::Timeline;
+        EInfinityCameraOwner Authored = Cue ? Cue->Scene.CameraOwner : EInfinityCameraOwner::Timeline;
+        // GO1 Drives Camera (Gary, 2 Oct: Scene 6, "running forward still"):
+        // the one kind of Scene the live dog drives. Only a Scene cue honours
