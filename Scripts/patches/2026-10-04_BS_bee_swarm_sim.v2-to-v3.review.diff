--- a/Plugins/InfinityStage/Source/InfinityStageTests/Private/InfinityStageBeeSwarmTests.cpp
+++ b/Plugins/InfinityStage/Source/InfinityStageTests/Private/InfinityStageBeeSwarmTests.cpp
@@ -335,4 +335,65 @@ bool FInfinityStageBeeSwarmNonRepetitionTest::RunTest(const FString& Parameters)
