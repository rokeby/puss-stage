+TArray<FInfinityGoCue> ThreeCues()
+{
+    TArray<FInfinityGoCue> Cues;
+    const auto Add = [&Cues](const int32 Frame, const bool bHold)
+    {
+        FInfinityGoCue& Cue = Cues.AddDefaulted_GetRef();
+        Cue.Frame = Frame;
+        Cue.bHold = bHold;
+        Cue.Number = FString::FromInt(Cues.Num());
+    };
+    Add(100, true);
+    Add(150, false);
+    Add(200, true);
+    return Cues;
+}
+}
