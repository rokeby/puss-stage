+bool ParseMarkerLabel(const FString& Text, FString& OutNumber, FString& OutLabel, int32& OutMode)
+{
+    OutNumber.Reset();
+    OutLabel.Reset();
+    OutMode = -1;
+    TArray<FString> Words;
+    Text.TrimStartAndEnd().ParseIntoArrayWS(Words);
+    if (Words.Num() < 2 || !Words[0].Equals(TEXT("GO"), ESearchCase::IgnoreCase))
+    {
+        return false;
+    }
+    OutNumber = Words[1];
+    int32 LabelStart = 2;
+    if (Words.IsValidIndex(2) && Words[2].Equals(TEXT("HOLD"), ESearchCase::IgnoreCase))
+    {
+        OutMode = 1;
+        LabelStart = 3;
+    }
+    else if (Words.IsValidIndex(2) && Words[2].Equals(TEXT("PASS"), ESearchCase::IgnoreCase))
+    {
+        OutMode = 0;
+        LabelStart = 3;
+    }
+    for (int32 Index = LabelStart; Index < Words.Num(); ++Index)
+    {
+        OutLabel += (OutLabel.IsEmpty() ? TEXT("") : TEXT(" ")) + Words[Index];
+    }
+    return true;
+}
